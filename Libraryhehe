-- Image formatting will be handled by standard Roblox asset IDs.
local function FormatImage(id)
    if not id or id == "" then return "" end
    id = tostring(id)
    -- If it's already an rbxassetid, return it directly
    if string.find(id, "rbxassetid://") then return id end
    -- If it's a number, assume it's an asset ID and format it
    if tonumber(id) then return "rbxassetid://" .. id end
    -- Otherwise, assume it's a standard Roblox asset name or an invalid ID
    return id
end

