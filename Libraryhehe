    end

    local function startListening()
        listening = true
        keybindButton.Text = "..."
        local inputConnection
        inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
            if gameProcessedEvent then return end
            if listening then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = input.KeyCode
                elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
                    currentKey = input.UserInputType
                else
                    currentKey = nil
                end
                listening = false
                updateKeybindText()
                if callback then
                    pcall(callback, currentKey)
                end
                inputConnection:Disconnect()
            end
        end)
        addConnection(inputConnection)
    end

    addConnection(keybindButton.MouseButton1Click:Connect(function()
        if not listening then
            startListening()
        end
    end))

    addConnection(frame.Destroying:Connect(function()
        -- Additional cleanup for keybind elements
    end))

    return frame, function(newKey) currentKey = newKey; updateKeybindText() end
end

