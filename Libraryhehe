function KazeUI:CreateCollapsibleSection(parent, titleText, defaultCollapsed)
    local frame = Instance.new("Frame")
    frame.Name = "CollapsibleSection"
    frame.Size = UDim2.new(1, 0, 0, 30) -- Initial size for title bar
    frame.BackgroundTransparency = 1
    frame.AutomaticSize = Enum.AutomaticSize.Y
    frame.Parent = parent

    local titleBar = Instance.new("TextButton", frame)
    titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1, 0, 0, 30)
    titleBar.BackgroundTransparency = 1
    titleBar.Text = titleText
    titleBar.Font = Enum.Font.GothamBold
    titleBar.TextSize = 16
    titleBar.TextXAlignment = Enum.TextXAlignment.Left
    titleBar.TextYAlignment = Enum.TextYAlignment.Center
    titleBar.TextWrapped = true
    Instance.new("UIPadding", titleBar).PaddingLeft = UDim.new(0, 10)
    KazeUI:RegisterText(titleBar, false)

    local arrowIcon = Instance.new("ImageLabel", titleBar)
    arrowIcon.Name = "ArrowIcon"
    arrowIcon.Size = UDim2.fromOffset(16, 16)
    arrowIcon.Position = UDim2.new(1, -25, 0.5, -8)
    arrowIcon.AnchorPoint = Vector2.new(1, 0.5)
    arrowIcon.BackgroundTransparency = 1
    arrowIcon.Image = "rbxassetid://5060699195" -- Placeholder for an arrow icon
    arrowIcon.ImageColor3 = KazeUI.CurrentTheme.Text
    KazeUI:OnThemeChanged(arrowIcon, function(t) arrowIcon.ImageColor3 = t.Text end)

    local contentFrame = Instance.new("Frame", frame)
    contentFrame.Name = "ContentFrame"
    contentFrame.Size = UDim2.new(1, 0, 0, 0)
    contentFrame.Position = UDim2.new(0, 0, 0, 30)
    contentFrame.BackgroundTransparency = 1
    contentFrame.AutomaticSize = Enum.AutomaticSize.Y
    local listLayout = Instance.new("UIListLayout", contentFrame)
    listLayout.FillDirection = Enum.FillDirection.Vertical
    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    listLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    listLayout.Padding = UDim.new(0, 5)
    Instance.new("UIPadding", contentFrame).PaddingLeft = UDim.new(0, 10)
    Instance.new("UIPadding", contentFrame).PaddingRight = UDim.new(0, 10)

    local isCollapsed = defaultCollapsed or false

    local function updateCollapseState()
        if isCollapsed then
            contentFrame.Visible = false
            arrowIcon.Rotation = 0 -- Point right
            frame.Size = UDim2.new(1, 0, 0, 30)
        else
            contentFrame.Visible = true
            arrowIcon.Rotation = 90 -- Point down
            frame.Size = UDim2.new(1, 0, 0, 30 + contentFrame.AbsoluteSize.Y) -- Adjust size based on content
        end
    end

    addConnection(titleBar.MouseButton1Click:Connect(function()
        isCollapsed = not isCollapsed
        updateCollapseState()
    end))

    addConnection(contentFrame.ChildAdded:Connect(function()
        if not isCollapsed then
            frame.Size = UDim2.new(1, 0, 0, 30 + contentFrame.AbsoluteSize.Y)
        end
    end))
    addConnection(contentFrame.ChildRemoved:Connect(function()
        if not isCollapsed then
            frame.Size = UDim2.new(1, 0, 0, 30 + contentFrame.AbsoluteSize.Y)
        end
    end))

    updateCollapseState()

    addConnection(frame.Destroying:Connect(function()
        -- Additional cleanup for collapsible section elements
    end))

    return frame, contentFrame
end

