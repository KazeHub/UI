local glowHeartbeatConn = nil
local activeGlowElements = {}

local function StartNeonLoop(instance)
    if not instance or not instance:IsA("GuiObject") then return end
    table.insert(activeGlowElements, instance)
    if not glowHeartbeatConn then
        glowHeartbeatConn = RunService.Heartbeat:Connect(function()
            for i = #activeGlowElements, 1, -1 do
                local inst = activeGlowElements[i]
                if not inst or not inst.Parent then
                    table.remove(activeGlowElements, i)
                else
                    local hue = (tick() % 4) / 4
                    local rainbowColor = Color3.fromHSV(hue, 0.8, 1)
                    if KazeUI.GlowRainbow then
                        inst.BackgroundColor3 = rainbowColor
                    else
                        inst.BackgroundColor3 = KazeUI.GlowColor
                    end
                end
            end
        end)
    end
end

local function StopNeonLoop(instance)
    if not instance then return end
    for i = #activeGlowElements, 1, -1 do
        if activeGlowElements[i] == instance then
            table.remove(activeGlowElements, i)
            break
        end
    end
    if #activeGlowElements == 0 and glowHeartbeatConn then
        glowHeartbeatConn:Disconnect()
        glowHeartbeatConn = nil
    end
end
