-- Config System (Re-architected for standard Roblox using DataStoreService)
local DataStoreService = game:GetService("DataStoreService")
local configStore = DataStoreService:GetDataStore("KazeUI_Config")

function KazeUI:SaveConfig(name)
    if not name or name == "" then
        KazeUI:Notify({Title = "Config System", Content = "Config name cannot be empty.", Duration = 3})
        return
    end

    local data = {}
    for flag, obj in pairs(KazeUI.Flags) do
        local success, value = pcall(obj.Get)
        if success then
            data[flag] = value
        else
            warn("KazeUI:SaveConfig - Failed to get value for flag: ", flag, ", Error: ", value)
        end
    end

    local playerUserId = LocalPlayer.UserId
    local configKey = "User_" .. playerUserId .. "_" .. name

    local success, err = pcall(function()
        configStore:SetAsync(configKey, data)
    end)

    if success then
        KazeUI:Notify({Title = "Config Saved", Content = "Successfully saved config: " .. name, Duration = 3})
    else
        KazeUI:Notify({Title = "Config Error", Content = "Failed to save config: " .. err, Duration = 3})
        warn("KazeUI:SaveConfig - Error saving config: ", err)
    end
end

function KazeUI:LoadConfig(name)
    if not name or name == "" then
        KazeUI:Notify({Title = "Config System", Content = "Config name cannot be empty.", Duration = 3})
        return
    end

    local playerUserId = LocalPlayer.UserId
    local configKey = "User_" .. playerUserId .. "_" .. name

    local success, data = pcall(function()
        return configStore:GetAsync(configKey)
    end)

    if success and data then
        if type(data) == "table" then
            for flag, val in pairs(data) do
                if KazeUI.Flags[flag] and KazeUI.Flags[flag].Set then
                    local setSuccess, setError = pcall(KazeUI.Flags[flag].Set, val)
                    if not setSuccess then
                        warn("KazeUI:LoadConfig - Failed to set value for flag: ", flag, ", Error: ", setError)
                    end
                else
                    warn("KazeUI:LoadConfig - Flag not found or Set function missing for: ", flag)
                end
            end
            KazeUI:Notify({Title = "Config System", Content = "Successfully loaded config: " .. name, Duration = 3})
        else
            KazeUI:Notify({Title = "Config Error", Content = "Loaded config data is corrupted or not a table.", Duration = 3})
            warn("KazeUI:LoadConfig - Loaded data for " .. configKey .. " is not a table.")
        end
    elseif not success then
        KazeUI:Notify({Title = "Config Error", Content = "Failed to load config: " .. data, Duration = 3})
        warn("KazeUI:LoadConfig - Error loading config: ", data)
    else
        KazeUI:Notify({Title = "Config System", Content = "Config file not found: " .. name, Duration = 3})
    end
end

