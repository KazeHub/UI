	ListScroller.ScrollBarThickness = 4
	ListScroller.ZIndex = 502
	ListScroller.CanvasSize = UDim2.new(0, 0, 0, 0)
	ListScroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	ListScroller.Parent = Card

	-- Grid of cards: image on top, name underneath, wrapping left-to-right.
	local listLayout = Instance.new("UIGridLayout", ListScroller)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.FillDirection = Enum.FillDirection.Horizontal
	listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	listLayout.CellSize = UDim2.fromOffset(92, 110)
	listLayout.CellPadding = UDim2.fromOffset(12, 12)

	local listPadding = Instance.new("UIPadding", ListScroller)
	listPadding.PaddingTop = UDim.new(0, 12)
	listPadding.PaddingLeft = UDim.new(0, 16)
	listPadding.PaddingRight = UDim.new(0, 16)
	listPadding.PaddingBottom = UDim.new(0, 12)

	if #supportedGames == 0 then
		local emptyLabel = Instance.new("TextLabel")
		emptyLabel.BackgroundTransparency = 1
		emptyLabel.Size = UDim2.new(1, 0, 0, 30)
		emptyLabel.Font = Enum.Font.Gotham
		emptyLabel.TextSize = 13
		emptyLabel.Text = "No supported-game list was provided."
		emptyLabel.ZIndex = 503
		emptyLabel.Parent = ListScroller
		KazeUI:RegisterText(emptyLabel, true)
	end

	for i, entry in ipairs(supportedGames) do
		local name, placeId, imageId
		if type(entry) == "table" then
			name = tostring(entry.Name or entry.Title or ("Game " .. i))
			placeId = entry.PlaceId
			imageId = entry.Image or entry.Icon or entry.Thumbnail
		else
			name = tostring(entry)
			placeId = nil
			imageId = nil
		end

		local isThisGame = placeId ~= nil and placeId == currentPlaceId
		if isThisGame then isCurrentSupported = true end

		-- UIGridLayout drives Size/Position itself; this card only needs content.
		local card = Instance.new("Frame")
		card.BackgroundTransparency = 1
		card.LayoutOrder = i
		card.ZIndex = 503
		card.Parent = ListScroller

		-- Game thumbnail. Priority: an explicit Image/Icon/Thumbnail on the
		-- entry always wins; otherwise, if the entry has a PlaceId, fetch that
		-- place's REAL Roblox game icon via MarketplaceService automatically
		-- (same technique as a typical hub's own GetInfo helper). With
		-- neither, fall back to a small muted glyph so every card still lines
		-- up on the same grid instead of leaving a blank gap.
		-- Literally square (equal offset width/height, not a scale-relative
		-- width against a non-square cell), centered in the cell. Fit (not
		-- Crop) so the whole icon is always visible instead of having its
		-- edges sliced off to fill a mismatched aspect ratio.
		local thumb = Instance.new("ImageLabel")
		thumb.AnchorPoint = Vector2.new(0.5, 0)
		thumb.Position = UDim2.new(0.5, 0, 0, 0)
		thumb.Size = UDim2.fromOffset(76, 76)
		thumb.BorderSizePixel = 0
		thumb.ScaleType = Enum.ScaleType.Fit
		thumb.ZIndex = 504
		thumb.Parent = card
		KazeUI:AddPanel(thumb, 0.08)
		Instance.new("UICorner", thumb).CornerRadius = UDim.new(0, 10)

		local fallbackIcon
		local function ShowFallback()
			thumb.ImageTransparency = 1
			if fallbackIcon then return end
			fallbackIcon = Instance.new("ImageLabel")
			fallbackIcon.AnchorPoint = Vector2.new(0.5, 0.5)
			fallbackIcon.Position = UDim2.fromScale(0.5, 0.5)
			fallbackIcon.Size = UDim2.fromOffset(26, 26)
			fallbackIcon.BackgroundTransparency = 1
			fallbackIcon.Image = FormatImage("gamepad-2")
			fallbackIcon.ScaleType = Enum.ScaleType.Fit
			fallbackIcon.ZIndex = 505
			fallbackIcon.Parent = thumb
			KazeUI:OnThemeChanged(fallbackIcon, function(t) fallbackIcon.ImageColor3 = t.MutedText end)
		end

		if imageId then
			thumb.Image = FormatImage(imageId)
		elseif placeId then
			ShowFallback() -- shown while the real icon loads
			GetPlaceInfo(placeId, function(info)
				if not thumb.Parent then return end -- gate closed before this resolved
				if info.Icon then
					thumb.Image = info.Icon
					thumb.ImageTransparency = 0
					if fallbackIcon then
						fallbackIcon:Destroy()
						fallbackIcon = nil
					end
				end
			end)
		else
			ShowFallback()
		end

		-- Status dot + name, left-aligned under the image (same left edge as
		-- the thumbnail above it): "• The Mimic". Every entry in this list is,
		-- by definition, supported -- so the dot defaults to green. Pass
		-- Color on an entry (hex string or Color3) to override it, e.g. orange
		-- for "temporarily down".
		local nameRow = Instance.new("Frame")
		nameRow.Name = "NameRow"
		nameRow.AnchorPoint = Vector2.new(0.5, 0)
		nameRow.Position = UDim2.new(0.5, 0, 0, 84)
		nameRow.Size = UDim2.fromOffset(76, 18)
		nameRow.BackgroundTransparency = 1
		nameRow.ZIndex = 504
		nameRow.Parent = card

		local entryColor = type(entry) == "table" and (entry.Color or entry.Status) or nil
		local statusColor = ResolveStatusColor(entryColor, Color3.fromRGB(80, 220, 120))

		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0, 0.5)
		dot.Position = UDim2.new(0, 0, 0.5, 0)
		dot.Size = UDim2.fromOffset(7, 7)
		dot.BorderSizePixel = 0
		dot.BackgroundColor3 = statusColor
		dot.ZIndex = 505
		dot.Parent = nameRow
		Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Position = UDim2.new(0, 13, 0, 0)
		nameLabel.Size = UDim2.new(1, -13, 1, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Font = isThisGame and Enum.Font.GothamBold or Enum.Font.Gotham
		nameLabel.TextSize = 12
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
		nameLabel.Text = name
		nameLabel.ZIndex = 504
		nameLabel.Parent = nameRow
		KazeUI:RegisterText(nameLabel, not isThisGame)
	end

	-- Footer: Discord/YouTube on the left, Continue/Exit on the right
	local Footer = Instance.new("Frame")
	Footer.Name = "Footer"
	Footer.Position = UDim2.new(0, 0, 1, -FOOTER_H)
	Footer.Size = UDim2.new(1, 0, 0, FOOTER_H)
	Footer.BackgroundTransparency = 1
	Footer.ZIndex = 502
	Footer.Parent = Card

	local footerDivider = Instance.new("Frame")
	footerDivider.Size = UDim2.new(1, 0, 0, 1)
	footerDivider.BorderSizePixel = 0
	footerDivider.ZIndex = 502
	footerDivider.Parent = Footer
	KazeUI:OnThemeChanged(footerDivider, function(t) footerDivider.BackgroundColor3 = t.Border end)

	local function MakeIconLink(iconId, accentColor, link, label)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.fromOffset(32, 32)
		btn.BackgroundColor3 = accentColor
		btn.BorderSizePixel = 0
		btn.Text = ""
		btn.AutoButtonColor = false
		btn.ZIndex = 503
		btn.Parent = Footer
		Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

		local icon = Instance.new("ImageLabel")
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.fromScale(0.5, 0.5)
		icon.Size = UDim2.fromOffset(16, 16)
		icon.BackgroundTransparency = 1
		icon.Image = FormatImage(iconId)
		icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
		icon.ScaleType = Enum.ScaleType.Fit
		icon.ZIndex = 504
		icon.Parent = btn

		btn.MouseButton1Click:Connect(function()
			if not link or link == "" then return end
			local copied = pcall(function() setclipboard(link) end)
			KazeUI:Notify({Title = label, Content = copied and "Link copied to clipboard." or link, Duration = 3})
		end)

		return btn
	end

	local discordBtn = MakeIconLink(73132811772878, Color3.fromRGB(88, 101, 242), discordLink, "Discord")
	discordBtn.Position = UDim2.new(0, 16, 0.5, 0)
	discordBtn.AnchorPoint = Vector2.new(0, 0.5)

	local youtubeBtn = MakeIconLink(123663668456341, Color3.fromRGB(255, 0, 0), youtubeLink, "YouTube")
	youtubeBtn.Position = UDim2.new(0, 56, 0.5, 0)
	youtubeBtn.AnchorPoint = Vector2.new(0, 0.5)

	local closing = false
	local function closeGate(callback)
		if closing then return end
		closing = true
		-- Release input the instant a choice is made, not after the fade
		-- finishes. Backdrop covers the whole screen (including, on mobile,
		-- the touch joystick/jump button underneath it) -- while Active stays
		-- true that's blocked, so this needs to drop immediately rather than
		-- waiting on the tween.
		Backdrop.Active = false
		local fade = TweenService:Create(Backdrop, TWEEN_SMOOTH, {BackgroundTransparency = 1})
		fade:Play()
		-- Guaranteed cleanup even if Completed never fires for some reason
		-- (interrupted tween, etc.) -- don't leave the backdrop sitting there.
		task.delay(TWEEN_SMOOTH.Time, function()
			if Backdrop and Backdrop.Parent then Backdrop:Destroy() end
		end)
		if callback then task.spawn(callback) end
	end

	local ExitBtn = Instance.new("TextButton")
	ExitBtn.AnchorPoint = Vector2.new(1, 0.5)
	ExitBtn.Position = UDim2.new(1, -16, 0.5, 0)
	ExitBtn.Size = UDim2.fromOffset(72, 34)
	ExitBtn.Text = "Exit"
	ExitBtn.Font = Enum.Font.GothamBold
	ExitBtn.TextSize = 13
	ExitBtn.BorderSizePixel = 0
	ExitBtn.ZIndex = 503
	ExitBtn.Parent = Footer
	KazeUI:AddPanel(ExitBtn, 0.06)
	KazeUI:RegisterText(ExitBtn, false)
	Instance.new("UICorner", ExitBtn).CornerRadius = UDim.new(0, 10)
	ExitBtn.MouseButton1Click:Connect(function() closeGate(onExit) end)

	local ContinueBtn = Instance.new("TextButton")
	ContinueBtn.AnchorPoint = Vector2.new(1, 0.5)
	ContinueBtn.Position = UDim2.new(1, -96, 0.5, 0)
	ContinueBtn.Size = UDim2.fromOffset(100, 34)
	ContinueBtn.Text = "Continue"
	ContinueBtn.Font = Enum.Font.GothamBold
	ContinueBtn.TextSize = 13
	ContinueBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	ContinueBtn.BorderSizePixel = 0
	ContinueBtn.ZIndex = 503
	ContinueBtn.Parent = Footer
	Instance.new("UICorner", ContinueBtn).CornerRadius = UDim.new(0, 10)
	KazeUI:OnThemeChanged(ContinueBtn, function() ContinueBtn.BackgroundColor3 = KazeUI.GlowColor end)
	ContinueBtn.MouseButton1Click:Connect(function() closeGate(onContinue) end)

	-- Entrance
	Card.Size = UDim2.fromOffset(CARD_W, 0)
	TweenService:Create(Backdrop, TWEEN_SMOOTH, {BackgroundTransparency = 0.45}):Play()
	TweenService:Create(Card, TWEEN_SPRING, {Size = UDim2.fromOffset(CARD_W, CARD_H)}):Play()

	return {
		Root = Backdrop,
		IsCurrentGameSupported = isCurrentSupported,
		Close = function() closeGate(nil) end,
	}
end

function KazeUI:CreateWindow(config)
	local ok, resultOrErr = pcall(BuildWindow, config)
	if not ok then
		-- The actual error used to be thrown away entirely -- not returned,
		-- not even printed -- so a failed CreateWindow gave the developer
		-- nothing to debug with besides "check the console" (which had
		-- nothing in it). First return value is kept as `nil` for backward
		-- compatibility with existing `local Window = KazeUI:CreateWindow(...)`
		-- call sites; the real error/traceback is now both logged and
		-- returned as a second value for callers that want it.
		local errMessage = tostring(resultOrErr)
		warn("[KazeUI] CreateWindow failed: " .. errMessage)
		pcall(function()
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "KazeUI failed to load",
				Text = "Check the developer console/output for the error.",
				Duration = 6
			})
		end)
		return nil, errMessage
	end
	return resultOrErr
end

return KazeUI
