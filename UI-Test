-- A standalone pre-gate screen: a header labelled "Supported Game List" with a
-- diagonal accent split, a scrollable list of the games the script actually
-- supports (SupportedGames is config-driven -- nothing here is invented or
-- hardcoded), and a footer with compact Discord/YouTube icon buttons on the
-- left and Continue/Exit on the right. Independent of CreateWindow -- call it
-- first and build the real window inside OnContinue, e.g.:
--
--   KazeUI:ShowGameSupportGate({
--       SupportedGames = {
--           {Name = "Blox Fruits", PlaceId = 2753915549},
--           {Name = "My Other Game", PlaceId = 123456789},
--       },
--       DiscordLink = "https://discord.gg/...",
--       YoutubeLink = "https://youtube.com/...",
--       OnContinue = function() local Window = KazeUI:CreateWindow({...}) end,
--       OnExit = function() end, -- optional; gate just closes if omitted
--   })
-- Parses a status-dot color override (hex string like "#22c55e"/"EF4444", or
-- a Color3 directly); falls back to the given default (used for the
-- supported-game-list dots, which default to green).
local function ResolveStatusColor(c, fallback)
	if typeof(c) == "Color3" then return c end
	if type(c) == "string" then
		local ok, res = pcall(Color3.fromHex, (string.gsub(c, "#", "")))
		if ok and res then return res end
	end
	return fallback
end

-- Shared, de-duplicated lookup of a place's real Roblox name/icon via
-- MarketplaceService -- same technique as a typical hub's own GetInfo helper.
-- Lets ShowGameSupportGate show each entry's ACTUAL game thumbnail just from
-- a PlaceId, instead of requiring the developer to supply an Image manually.
-- Cached per PlaceId; concurrent requests for the same PlaceId share one call.
local PlaceInfoCache = {}
local PlaceInfoWaiting = {}
local function GetPlaceInfo(placeId, callback)
	local cached = PlaceInfoCache[placeId]
	if cached then
		callback(cached)
		return
	end
	local waiting = PlaceInfoWaiting[placeId]
	if waiting then
		waiting[#waiting + 1] = callback
		return
	end
	PlaceInfoWaiting[placeId] = {callback}
	task.spawn(function()
		local info = {}
		local ok, res = pcall(function() return MarketplaceService:GetProductInfo(placeId) end)
		if ok and type(res) == "table" then
			info.Name = res.Name
			local icon = tonumber(res.IconImageAssetId)
			if icon and icon > 0 then info.Icon = "rbxassetid://" .. icon end
		end
		PlaceInfoCache[placeId] = info
		local list = PlaceInfoWaiting[placeId]
		PlaceInfoWaiting[placeId] = nil
		for _, fn in ipairs(list) do pcall(fn, info) end
	end)
end

