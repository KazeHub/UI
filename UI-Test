local function ToggleScrollingAncestors(element, state)
	local current = element.Parent
	while current do
		if current:IsA("ScrollingFrame") then current.ScrollingEnabled = state end
		current = current.Parent
	end
end

local TWEEN_CASCADE = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local CASCADE_STAGGER = 0.06
local CASCADE_RISE = 26

local CascadeState = setmetatable({}, {__mode = "k"})
local CASCADE_MAX_CHILDREN = 14

local function CancelCascade(container)
	local st = CascadeState[container]
	if not st then return end
	CascadeState[container] = nil
	st.Cancelled = true
	if st.Thread then
		pcall(task.cancel, st.Thread)
		st.Thread = nil
	end
	if st.Cleanup then
		pcall(task.cancel, st.Cleanup)
		st.Cleanup = nil
	end
	for _, item in ipairs(st.Items) do
		if item.Tween then item.Tween:Cancel() end
		local child = item.Child
		if child.Parent and child.Position ~= item.Pos then
			child.Position = item.Pos
		end
	end
end

local function AnimateComponentsIn(container)
	if not container then return end
	CancelCascade(container)
	if KazeUI.PerformanceMode then return end

	local limit = container.AbsoluteSize.Y
	if limit <= 0 then limit = 600 end
	limit = limit + 60
	local acc = 0
	local items = {}
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("GuiObject") and child.Visible then
			items[#items + 1] = {Child = child, Pos = child.Position}
			local h = child.AbsoluteSize.Y
			if h < 30 then h = math.max(30, child.Size.Y.Offset) end
			acc = acc + h + 5
			if acc > limit or #items >= CASCADE_MAX_CHILDREN then break end
		end
	end
	if #items == 0 then return end

	local st = {Items = items, Cancelled = false}
	CascadeState[container] = st

	for _, item in ipairs(items) do
		local p = item.Pos
		item.Child.Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset - CASCADE_RISE)
	end

	local t0 = os.clock()
	st.Thread = task.spawn(function()
		for i, item in ipairs(items) do
			local wait = t0 + (i - 1) * CASCADE_STAGGER - os.clock()
			if wait > 0 then task.wait(wait) end
			if st.Cancelled then return end
			local child = item.Child
			if child.Parent then
				local tw = TweenService:Create(child, TWEEN_CASCADE, {Position = item.Pos})
				item.Tween = tw
				tw:Play()
			end
		end
		st.Thread = nil
	end)

	st.Cleanup = task.delay((#items - 1) * CASCADE_STAGGER + TWEEN_CASCADE.Time + 0.1, function()
		st.Cleanup = nil
		if CascadeState[container] == st then CascadeState[container] = nil end
	end)
end

local PlayerHub = {Subs = {}, Count = 0, Pending = false, Conns = nil, Names = nil, Icons = nil, Leaving = setmetatable({}, {__mode = "k"})}

function PlayerHub.Options(withIcons)
	local cached = withIcons and PlayerHub.Icons or PlayerHub.Names
	if cached then return cached end
	local list = {}
	local leaving = PlayerHub.Leaving
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and not leaving[p] then
			if withIcons then
				list[#list + 1] = {Text = p.Name, Icon = "rbxthumb://type=AvatarHeadShot&id=" .. p.UserId .. "&w=48&h=48"}
			else
				list[#list + 1] = p.Name
			end
		end
	end
	if #list == 0 then
		list[1] = withIcons and {Text = "None", Icon = ""} or "None"
	end
	if withIcons then PlayerHub.Icons = list else PlayerHub.Names = list end
	return list
end

function PlayerHub.Unsubscribe(owner)
	if not PlayerHub.Subs[owner] then return end
	PlayerHub.Subs[owner] = nil
	PlayerHub.Count = PlayerHub.Count - 1
	if PlayerHub.Count <= 0 then
		PlayerHub.Count = 0
		local conns = PlayerHub.Conns
		if conns then
			PlayerHub.Conns = nil
			conns[1]:Disconnect()
			conns[2]:Disconnect()
		end
	end
end

function PlayerHub.Flush()
	PlayerHub.Pending = false
	PlayerHub.Names, PlayerHub.Icons = nil, nil
	for owner, sub in pairs(PlayerHub.Subs) do
		if owner.Parent then
			pcall(sub.Fn, PlayerHub.Options(sub.Icons))
		else
			PlayerHub.Unsubscribe(owner)
		end
	end
end

function PlayerHub.Mark(plr)
	if plr == LP then return end
	PlayerHub.Names, PlayerHub.Icons = nil, nil
	if not PlayerHub.Pending then
		PlayerHub.Pending = true
		task.defer(PlayerHub.Flush)
	end
end

function PlayerHub.OnRemoving(plr)
	PlayerHub.Leaving[plr] = true
	PlayerHub.Mark(plr)
end

function PlayerHub.Subscribe(owner, fn, withIcons)
	if PlayerHub.Subs[owner] then return end
	PlayerHub.Subs[owner] = {Fn = fn, Icons = withIcons}
	PlayerHub.Count = PlayerHub.Count + 1
	if PlayerHub.Count == 1 then
		PlayerHub.Names, PlayerHub.Icons = nil, nil
		PlayerHub.Conns = {
			Players.PlayerAdded:Connect(PlayerHub.Mark),
			Players.PlayerRemoving:Connect(PlayerHub.OnRemoving)
		}
	end
	owner.Destroying:Connect(function() PlayerHub.Unsubscribe(owner) end)
	fn(PlayerHub.Options(withIcons))
end

local function WirePlayerListRefresh(ownerInst, refreshFn, withIcons, interval)
	PlayerHub.Subscribe(ownerInst, refreshFn, withIcons and true or false)
end

