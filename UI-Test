	contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
	contentLayout.Padding = UDim.new(0, 5)
	contentLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local contentPadding = Instance.new("UIPadding", sectionContent)
	contentPadding.PaddingTop = UDim.new(0, 6)
	contentPadding.PaddingBottom = UDim.new(0, 8)
	contentPadding.PaddingLeft = UDim.new(0, 5)
	contentPadding.PaddingRight = UDim.new(0, 5)

	local toggleDetector = Instance.new("TextButton")
	toggleDetector.Size = UDim2.fromScale(1, 1)
	toggleDetector.BackgroundTransparency = 1
	toggleDetector.Text = ""
	toggleDetector.ZIndex = 10
	toggleDetector.Parent = headerFrame

	local openTween
	local function setClipperOpen(open)
		if openTween then openTween:Cancel() end
		if open then

			contentClipper.AutomaticSize = Enum.AutomaticSize.None
			local targetHeight = sectionContent.AbsoluteSize.Y
			openTween = TweenService:Create(contentClipper, TWEEN_COLLAPSE, {Size = UDim2.new(1, 0, 0, targetHeight)})
			local thisTween = openTween
			thisTween.Completed:Connect(function()
				if isOpen and contentClipper.Parent then
					contentClipper.AutomaticSize = Enum.AutomaticSize.Y
				end
			end)
			thisTween:Play()
		else

			contentClipper.Size = UDim2.new(1, 0, 0, contentClipper.AbsoluteSize.Y)
			contentClipper.AutomaticSize = Enum.AutomaticSize.None
			openTween = TweenService:Create(contentClipper, TWEEN_COLLAPSE, {Size = UDim2.new(1, 0, 0, 0)})
			openTween:Play()
		end
	end

	local function toggleSection()
		isOpen = not isOpen
		setClipperOpen(isOpen)

		if isOpen then
			TweenService:Create(arrowIcon, TWEEN_COLLAPSE, {
				Rotation = 0,
				ImageColor3 = KazeUI.CurrentTheme.Text
			}):Play()
			StartNeonLoop(boxStroke)
			StartNeonLoop(accentLine)
		else
			TweenService:Create(arrowIcon, TWEEN_COLLAPSE, {
				Rotation = -90,
				ImageColor3 = KazeUI.CurrentTheme.MutedText
			}):Play()
			TweenService:Create(accentLine, TWEEN_COLLAPSE, {
				BackgroundColor3 = KazeUI.CurrentTheme.MutedText
			}):Play()
			StopNeonLoop(boxStroke)
			StopNeonLoop(accentLine)
			boxStroke.Color = KazeUI.CurrentTheme.Border
			accentLine.BackgroundColor3 = KazeUI.CurrentTheme.MutedText
		end
	end

	toggleDetector.MouseEnter:Connect(function()
		if activeDialogsCount > 0 then return end
		TweenService:Create(headerFrame, TWEEN_HOVER_SLOW, {BackgroundColor3 = KazeUI.GetColor(0.04), BackgroundTransparency = 0.4}):Play()
	end)
	toggleDetector.MouseLeave:Connect(function()
		TweenService:Create(headerFrame, TWEEN_HOVER_SLOW, {BackgroundTransparency = 1}):Play()
	end)

	BindPressAnimation(toggleDetector,
		function() return activeDialogsCount == 0 end,
		function()
			local curY = sectionBox.Size.Y
			TweenService:Create(sectionBox, TWEEN_QUICK, {Size = UDim2.new(0.93, 0, curY.Scale, curY.Offset)}):Play()
		end,
		function()
			task.defer(function()
				local curY = sectionBox.Size.Y
				TweenService:Create(sectionBox, TWEEN_QUICK, {Size = UDim2.new(0.95, 0, curY.Scale, curY.Offset)}):Play()
			end)
		end,
		toggleSection
	)

	if openDefault then toggleSection() end

	local sectionPublic = { Frame = sectionBox, ContentFrame = sectionContent, Header = headerFrame }
	AttachElementsToAPI(sectionPublic, sectionContent, currentDepth + 1)
	function sectionPublic:SetText(newText) titleLabel.Text = newText end
	sectionPublic.SetVisible = ElementSetVisible
	sectionPublic.Destroy = ElementDestroy
	return sectionPublic
end

