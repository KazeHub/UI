				if item.Btn.LayoutOrder ~= n then item.Btn.LayoutOrder = n end
			end
		end
		visibleCount = n
		ApplyGrid()
	end

	local function BoxOptionListUnchanged(nextOptions)
		if #nextOptions ~= #options then return false end
		for i = 1, #options do
			if OptionText(options[i]) ~= OptionText(nextOptions[i]) or OptionIcon(options[i]) ~= OptionIcon(nextOptions[i]) then
				return false
			end
		end
		return true
	end

	local function Refresh(newOptions)
		local nextOptions = type(newOptions) == "table" and newOptions or options
		-- Same idea as the plain Dropdown's Refresh: skip the destroy/rebuild
		-- of every box when the option list (text + icon) hasn't actually changed.
		if not itemsStale and nextOptions == options then
			-- caller passed no real new list (fell back to the existing `options`
			-- reference above) -- definitely nothing changed, nothing to do
			return
		elseif not itemsStale and BoxOptionListUnchanged(nextOptions) then
			options = nextOptions
			return
		end

		for _, item in ipairs(boxItems) do item.Btn:Destroy() end
		table.clear(boxItems)
		itemsStale = false

		options = nextOptions

		anyIcons = false
		for _, o in ipairs(options) do
			if OptionIcon(o) then anyIcons = true break end
		end
		cellHeight = anyIcons and 64 or 32

		for i, opt in ipairs(options) do
			local optStr = OptionText(opt)
			local optIcon = OptionIcon(opt)
			local box = Instance.new("TextButton")
			box.LayoutOrder = i
			box.BorderSizePixel = 0
			box.Text = ""
			box.Parent = gridContainer
			Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
			KazeUI:AddPanel(box, 0.03, true)

			local boxStrokeItem = Instance.new("UIStroke", box)
			boxStrokeItem.Thickness = 1
			KazeUI:RegisterBorder(boxStrokeItem)

			local iconImg
			if optIcon and anyIcons then
				iconImg = Instance.new("ImageLabel")
				iconImg.AnchorPoint = Vector2.new(0.5, 0)
				iconImg.Position = UDim2.new(0.5, 0, 0, 8)
				iconImg.Size = UDim2.fromOffset(26, 26)
				iconImg.BackgroundTransparency = 1
				iconImg.ScaleType = Enum.ScaleType.Fit
				iconImg.Parent = box
				KazeUI:OnThemeChanged(iconImg, function(t) iconImg.ImageColor3 = t.Text end)
				ResolveIconImage(iconImg, optIcon)
			end

			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.Gotham
			label.TextSize = 11
			label.TextScaled = true
			label.Text = optStr
			label.Parent = box
			local labelSizeConstraint = Instance.new("UITextSizeConstraint")
			labelSizeConstraint.MaxTextSize = 11
			labelSizeConstraint.MinTextSize = 7
			labelSizeConstraint.Parent = label
			if anyIcons then
				label.Size = UDim2.new(1, -6, 0, 16)
				label.Position = UDim2.new(0, 3, 1, -20)
			else
				label.Size = UDim2.new(1, -6, 1, 0)
				label.Position = UDim2.new(0, 3, 0, 0)
			end

			local isHovering = false
			local lastBg, lastTxt, lastActive, lastBorder

			local function UpdateVisuals(instant)
				local active = isMulti and selectedMulti[optStr] or (not isMulti and selectedSingle == optStr)
				local targetBg = active and KazeUI.GetColor(0.08) or KazeUI.GetColor(0.03)
				local targetTxt = active and KazeUI.CurrentTheme.Text or KazeUI.CurrentTheme.MutedText

				if isHovering then
					targetBg = KazeUI.GetColor(0.1)
					targetTxt = KazeUI.CurrentTheme.Text
				end

				local activeFlag = active and true or false
				local borderNow = KazeUI.CurrentTheme.Border
				if targetBg == lastBg and targetTxt == lastTxt and activeFlag == lastActive and borderNow == lastBorder then return end
				lastBg, lastTxt, lastActive, lastBorder = targetBg, targetTxt, activeFlag, borderNow

				if instant then
					box.BackgroundColor3 = targetBg
					label.TextColor3 = targetTxt
				else
					TweenService:Create(box, TWEEN_FAST, {BackgroundColor3 = targetBg}):Play()
					TweenService:Create(label, TWEEN_FAST, {TextColor3 = targetTxt}):Play()
				end

				if active then
					StartNeonLoop(boxStrokeItem)
				else
					StopNeonLoop(boxStrokeItem)
					TweenService:Create(boxStrokeItem, TWEEN_FAST, {Color = KazeUI.CurrentTheme.Border}):Play()
				end
			end
			UpdateVisuals(true)

			KazeUI:OnThemeChanged(box, function() UpdateVisuals(true) end)

			box.MouseEnter:Connect(function()
				if isLockedState or activeDialogsCount > 0 then return end
				isHovering = true
				UpdateVisuals(false)
			end)
			box.MouseLeave:Connect(function()
				isHovering = false
				UpdateVisuals(false)
			end)

			box.MouseButton1Click:Connect(function()
				if isLockedState or activeDialogsCount > 0 then return end

				if isMulti then
					selectedMulti[optStr] = not selectedMulti[optStr]
					UpdateHeaderVisual()
					FireCallback(callback, CollectMultiSelection(selectedMulti))
				else
					selectedSingle = optStr
					UpdateHeaderVisual()
					for _, item in ipairs(boxItems) do item.Update(false) end
					FireCallback(callback, selectedSingle)
				end
				UpdateVisuals(false)
			end)

			table.insert(boxItems, {Btn = box, Text = optStr, Lower = string.lower(optStr), Update = function(instant) UpdateVisuals(instant) end})
		end

		ApplyFilter()
	end

	if searchBarEnabled and searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
