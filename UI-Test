		SetLocked = function(self, state)
			isLockedState = state
			lockCtrl:SetLocked(state)
		end,
		SetValue = function(self, val) ApplySelection(val) end,
		OnChanged = function(self, fn) callback = ChainCallback(callback, fn) end
	}, flag)
end

