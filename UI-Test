	function Win:Dialog(dialogConfig)
		dialogConfig = dialogConfig or {}
		local title = tostring(dialogConfig.Title or "Dialog")
		local content = tostring(dialogConfig.Content or "")
		local iconId = dialogConfig.Icon and FormatImage(dialogConfig.Icon) or ""
		local hasIcon = (iconId ~= "")
		local actions = dialogConfig.Actions or {}
		if #actions == 0 then actions = {{ Name = "OK" }} end

		local orderedActions = {}
		for i, act in ipairs(actions) do orderedActions[i] = act end
		table.sort(orderedActions, function(a, b)
			local oa, ob = tonumber(a.Order), tonumber(b.Order)
			if oa and ob then return oa < ob end
			if oa and not ob then return true end
			if ob and not oa then return false end
			return false
		end)

		local actionsPosition = (dialogConfig.ActionsPosition == "Top") and "Top" or "Bottom"

		local actionsLayout = dialogConfig.ActionsLayout

		activeDialogsCount = activeDialogsCount + 1

		InteractionBlocker.Visible = true
		TweenService:Create(InteractionBlocker, TWEEN_FAST, {BackgroundTransparency = 0.65}):Play()

		local DialogFrame = Instance.new("Frame", Window)
		DialogFrame.Name = "WindowDialog"
		DialogFrame.Size = UDim2.fromOffset(380, 220)
		DialogFrame.AnchorPoint = Vector2.new(0.5, 0.5)
		DialogFrame.Position = UDim2.fromScale(0.5, 0.4)
		DialogFrame.ZIndex = 101
		DialogFrame.Active = true
		DialogFrame.BackgroundTransparency = 0.08

		Instance.new("UICorner", DialogFrame).CornerRadius = UDim.new(0, 14)
		KazeUI:AddPanel(DialogFrame, 0.04, false, true)

		local stroke = Instance.new("UIStroke", DialogFrame)
		stroke.Thickness = 1.4
		KazeUI:RegisterBorder(stroke)

		TweenService:Create(DialogFrame, TWEEN_SPRING, {Position = UDim2.fromScale(0.5, 0.5)}):Play()

		local totalActions = #orderedActions
		local shouldStack
		if actionsLayout == "Vertical" then
			shouldStack = true
		elseif actionsLayout == "Horizontal" then
			shouldStack = false
		elseif actionsLayout == "Grid" then
			shouldStack = "grid"
		else
			shouldStack = (totalActions >= 4)
		end

		local gridColumns = 2
		local actionsHeight
		if shouldStack == "grid" then
			local rows = math.ceil(totalActions / gridColumns)
			actionsHeight = (rows * 32) + ((rows - 1) * 8)
		elseif shouldStack then
			actionsHeight = (totalActions * 32) + ((totalActions - 1) * 8)
		else
			actionsHeight = 32
		end

		local topOffset = 18
		if hasIcon then
			local dIcon = Instance.new("ImageLabel", DialogFrame)
			dIcon.Size = UDim2.fromOffset(36, 36)
			dIcon.Position = UDim2.new(0.5, -18, 0, 18)
			dIcon.BackgroundTransparency = 1
			dIcon.Image = iconId
			dIcon.ZIndex = 102
			KazeUI:OnThemeChanged(dIcon, function(t) dIcon.ImageColor3 = KazeUI.GlowColor end)
			topOffset = 62
		end

		local titleSize = TextService:GetTextSize(title, 15, Enum.Font.GothamBold, Vector2.new(340, 1000))
		local contentSize = TextService:GetTextSize(content, 12, Enum.Font.GothamMedium, Vector2.new(340, 2000))

		local titleHeight = math.ceil(titleSize.Y)
		local contentHeight = math.ceil(contentSize.Y)

		local titleLabel = Instance.new("TextLabel", DialogFrame)
		titleLabel.Size = UDim2.new(1, -40, 0, titleHeight)
		titleLabel.Position = UDim2.fromOffset(20, topOffset)
		titleLabel.BackgroundTransparency = 1
		titleLabel.Text = title
		titleLabel.Font = Enum.Font.GothamBold
		titleLabel.TextSize = 15
		titleLabel.TextWrapped = true
		titleLabel.TextXAlignment = Enum.TextXAlignment.Center
		titleLabel.ZIndex = 102
		KazeUI:RegisterText(titleLabel, false)

		local actionsTop = topOffset + titleHeight + 8
		local contentTop = actionsTop
		if actionsPosition == "Top" then
			contentTop = actionsTop + actionsHeight + 12
		end

		local contentLabel = Instance.new("TextLabel", DialogFrame)
		contentLabel.Size = UDim2.new(1, -40, 0, contentHeight)
		contentLabel.Position = UDim2.fromOffset(20, contentTop)
		contentLabel.BackgroundTransparency = 1
		contentLabel.Text = content
		contentLabel.Font = Enum.Font.GothamMedium
		contentLabel.TextSize = 12
		contentLabel.TextWrapped = true
		contentLabel.TextXAlignment = Enum.TextXAlignment.Center
		contentLabel.TextYAlignment = Enum.TextYAlignment.Top
		contentLabel.ZIndex = 102
		KazeUI:RegisterText(contentLabel, false)

		local ActionsFrame = Instance.new("Frame", DialogFrame)
		ActionsFrame.BackgroundTransparency = 1
		ActionsFrame.ZIndex = 102
		if actionsPosition == "Top" then
			ActionsFrame.Position = UDim2.fromOffset(15, actionsTop)
		else
			ActionsFrame.Position = UDim2.new(0, 15, 1, -15)
			ActionsFrame.AnchorPoint = Vector2.new(0, 1)
		end

		local alignMap = {
			Left = Enum.HorizontalAlignment.Left,
			Center = Enum.HorizontalAlignment.Center,
			Right = Enum.HorizontalAlignment.Right
		}

		local buttonWidth
		if shouldStack == "grid" then
			buttonWidth = (350 - ((gridColumns - 1) * 8)) / gridColumns
			local gridLayout = Instance.new("UIGridLayout", ActionsFrame)
			gridLayout.CellSize = UDim2.fromOffset(buttonWidth, 32)
			gridLayout.CellPadding = UDim2.fromOffset(8, 8)
			gridLayout.FillDirectionMaxCells = gridColumns
			gridLayout.HorizontalAlignment = alignMap[dialogConfig.ActionsAlign] or Enum.HorizontalAlignment.Center
			gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
			ActionsFrame.Size = UDim2.new(1, -30, 0, actionsHeight)
		else
			local listLayout = Instance.new("UIListLayout", ActionsFrame)
			listLayout.SortOrder = Enum.SortOrder.LayoutOrder
			listLayout.HorizontalAlignment = alignMap[dialogConfig.ActionsAlign] or Enum.HorizontalAlignment.Center
			listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
			listLayout.Padding = UDim.new(0, 8)

			if shouldStack then
				listLayout.FillDirection = Enum.FillDirection.Vertical
				buttonWidth = 350
				ActionsFrame.Size = UDim2.new(1, -30, 0, actionsHeight)
			else
				listLayout.FillDirection = Enum.FillDirection.Horizontal
				buttonWidth = totalActions > 0 and (350 - ((totalActions - 1) * 8)) / totalActions or 100
				ActionsFrame.Size = UDim2.new(1, -30, 0, 32)
			end
		end

		local dialogClosing = false
		local function closeDialog()
			if dialogClosing then return end
			dialogClosing = true
			TweenService:Create(InteractionBlocker, TWEEN_FAST, {BackgroundTransparency = 1}):Play()
			local closeInfo = TWEEN_FAST
			TweenService:Create(DialogFrame, closeInfo, {Position = UDim2.fromScale(0.5, 0.4)}):Play()
			task.wait(closeInfo.Time)
			DialogFrame:Destroy()
			InteractionBlocker.Visible = false
			activeDialogsCount = math.max(0, activeDialogsCount - 1)
		end

		for i, act in ipairs(orderedActions) do
			local btnName = act.Name or "Button"
			local callback = act.Callback

			local actionBtn = Instance.new("TextButton", ActionsFrame)
			actionBtn.Size = UDim2.new(0, buttonWidth, 0, 32)
			actionBtn.ZIndex = 103
			actionBtn.AutoButtonColor = false
			actionBtn.Text = ""
			actionBtn.LayoutOrder = i
			Instance.new("UICorner", actionBtn).CornerRadius = UDim.new(0, 10)

			local btnText = Instance.new("TextLabel", actionBtn)
			btnText.Size = UDim2.new(1, -12, 1, 0)
			btnText.Position = UDim2.fromOffset(6, 0)
			btnText.BackgroundTransparency = 1
			btnText.Text = btnName
			btnText.Font = Enum.Font.GothamBold
			btnText.TextSize = 11
			btnText.TextWrapped = true
			btnText.TextScaled = true
			btnText.ZIndex = 104

			local textConstraint = Instance.new("UITextSizeConstraint", btnText)
			textConstraint.MaxTextSize = 11
			textConstraint.MinTextSize = 7

			local btnColor = act.Color
			if type(btnColor) == "string" then
				local cleanHex = string.gsub(btnColor, "#", "")
				local s, res = pcall(function() return Color3.fromHex(cleanHex) end)
				if s and res then btnColor = res else btnColor = KazeUI.GlowColor end
			elseif typeof(btnColor) ~= "Color3" then
				btnColor = nil
			end

			if btnColor then
				actionBtn.BackgroundColor3 = btnColor
				btnText.TextColor3 = Color3.fromRGB(255, 255, 255)
			else
				KazeUI:AddPanel(actionBtn, 0.04)
				KazeUI:RegisterText(btnText, false)
			end

			local isHovered = false
			actionBtn.MouseEnter:Connect(function()
				isHovered = true
				if btnColor then
					local h, s, v = Color3.toHSV(btnColor)
					TweenService:Create(actionBtn, TWEEN_FAST, {BackgroundColor3 = Color3.fromHSV(h, s, math.clamp(v - 0.1, 0, 1))}):Play()
				else
					TweenService:Create(actionBtn, TWEEN_FAST, {BackgroundColor3 = KazeUI.GetColor(0.06)}):Play()
				end
			end)
			actionBtn.MouseLeave:Connect(function()
				isHovered = false
				if btnColor then
					TweenService:Create(actionBtn, TWEEN_FAST, {BackgroundColor3 = btnColor}):Play()
				else
					TweenService:Create(actionBtn, TWEEN_FAST, {BackgroundColor3 = KazeUI.GetColor(0.04)}):Play()
				end
			end)

			actionBtn.MouseButton1Click:Connect(function()
				task.spawn(function()
					if type(callback) == "function" then
						pcall(callback)
					end
				end)
				closeDialog()
			end)
		end

		local finalHeight
		if actionsPosition == "Top" then
			finalHeight = contentTop + contentHeight + 20
		else
			finalHeight = topOffset + titleHeight + 8 + contentHeight + 20 + actionsHeight + 18
		end
		DialogFrame.Size = UDim2.fromOffset(380, finalHeight)

		return {
			Close = closeDialog
		}
	end

	function Win:Destroy()
		ScreenGui:Destroy()
		OpenButtonGui:Destroy()
		DialogGui:Destroy()
		NotifScreenGui:Destroy()
	end

	local cardDepth = 0

	local function CardColor(c)
		if type(c) == "string" then
			local ok, res = pcall(Color3.fromHex, (string.gsub(c, "#", "")))
			if ok and res then return res end
			return nil
		end
		if typeof(c) == "Color3" then return c end
		return nil
	end

	function Win:Card(cfg)
		cfg = type(cfg) == "table" and cfg or {}
		local actions = type(cfg.Actions) == "table" and #cfg.Actions > 0 and cfg.Actions or {{ Name = "OK" }}
		local items = type(cfg.Items) == "table" and #cfg.Items > 0 and cfg.Items or nil
		local dim = cfg.Dim ~= false

		cardDepth = cardDepth + 1
		local depth = cardDepth
		local z = 100 + depth * 10
		activeDialogsCount = activeDialogsCount + 1

		local shield
		if depth == 1 then
			InteractionBlocker.Visible = true
			TweenService:Create(InteractionBlocker, TWEEN_FAST, {BackgroundTransparency = dim and 0.65 or 1}):Play()
		else
			shield = Instance.new("TextButton")
			shield.Name = "CardShield"
			shield.Size = UDim2.fromScale(1, 1)
			shield.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			shield.BackgroundTransparency = 1
			shield.BorderSizePixel = 0
			shield.Text = ""
			shield.AutoButtonColor = false
			shield.Active = true
			shield.ZIndex = z - 1
			shield.Parent = Window
			Instance.new("UICorner", shield).CornerRadius = blockerCorner.CornerRadius
			TweenService:Create(shield, TWEEN_FAST, {BackgroundTransparency = dim and 0.55 or 1}):Play()
		end

		local card = Instance.new("Frame")
		card.Name = "KazeCard"
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.45)
		card.Size = UDim2.fromOffset(300, 0)
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.ZIndex = z
		card.Active = true
		card.BackgroundTransparency = 0.08
		card.Parent = Window
		Instance.new("UICorner", card).CornerRadius = UDim.new(0, 14)
		KazeUI:AddPanel(card, 0.04, false, true)

		local cardStroke = Instance.new("UIStroke", card)
		cardStroke.Thickness = 1.4
		KazeUI:RegisterBorder(cardStroke)

		local cardPad = Instance.new("UIPadding", card)
		cardPad.PaddingTop = UDim.new(0, 16)
		cardPad.PaddingBottom = UDim.new(0, 16)
		cardPad.PaddingLeft = UDim.new(0, 16)
		cardPad.PaddingRight = UDim.new(0, 16)

		local cardList = Instance.new("UIListLayout", card)
		cardList.SortOrder = Enum.SortOrder.LayoutOrder
		cardList.HorizontalAlignment = Enum.HorizontalAlignment.Center
		cardList.Padding = UDim.new(0, 8)

		TweenService:Create(card, TWEEN_SPRING, {Position = UDim2.fromScale(0.5, 0.5)}):Play()

		local function NewText(parent, text, font, size, muted, order)
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Text = text
			t.Font = font
			t.TextSize = size
			t.TextWrapped = true
			t.ZIndex = z + 1
			t.LayoutOrder = order or 0
			t.Parent = parent
			KazeUI:RegisterText(t, muted)
			return t
		end

		local imageLabel
		if cfg.Image ~= nil then
			-- Big banner, not a small icon: full card width, tall enough to
			-- actually read as "the game's image" the way a card like this is
			-- expected to look. Crop fills it from a square game icon instead
			-- of leaving letterboxed bars.
			local holder = Instance.new("Frame")
			holder.Name = "Thumb"
			holder.Size = UDim2.new(1, 0, 0, 150)
			holder.LayoutOrder = 1
			holder.ZIndex = z + 1
			holder.Parent = card
			Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 14)
			KazeUI:AddPanel(holder, 0.06)
			local holderStroke = Instance.new("UIStroke", holder)
			holderStroke.Thickness = 1
			KazeUI:RegisterBorder(holderStroke)

			imageLabel = Instance.new("ImageLabel")
			imageLabel.Size = UDim2.fromScale(1, 1)
			imageLabel.BackgroundTransparency = 1
			imageLabel.ScaleType = Enum.ScaleType.Crop
			imageLabel.Image = FormatImage(cfg.Image)
			imageLabel.ZIndex = z + 2
			imageLabel.Parent = holder
			Instance.new("UICorner", imageLabel).CornerRadius = UDim.new(0, 14)
		end

		-- Title line: a small status-colored dot (from SubtitleColor) sits
		-- right before the title, e.g. a green dot for a supported game --
		-- matches the bullet-point look in the reference layout. No dot if
		-- the card doesn't carry a SubtitleColor at all.
		local titleRow = Instance.new("Frame")
		titleRow.Name = "TitleRow"
		titleRow.BackgroundTransparency = 1
		titleRow.AutomaticSize = Enum.AutomaticSize.XY
		titleRow.Size = UDim2.fromOffset(0, 0)
		titleRow.LayoutOrder = 2
		titleRow.ZIndex = z + 1
		titleRow.Parent = card
		local titleRowLayout = Instance.new("UIListLayout", titleRow)
		titleRowLayout.FillDirection = Enum.FillDirection.Horizontal
		titleRowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		titleRowLayout.Padding = UDim.new(0, 6)

		local titleDotColor = CardColor(cfg.SubtitleColor)
		if titleDotColor then
			local titleDot = Instance.new("Frame")
			titleDot.Size = UDim2.fromOffset(9, 9)
			titleDot.BackgroundColor3 = titleDotColor
			titleDot.BorderSizePixel = 0
			titleDot.LayoutOrder = 1
			titleDot.ZIndex = z + 2
			titleDot.Parent = titleRow
			Instance.new("UICorner", titleDot).CornerRadius = UDim.new(1, 0)
		end

		local titleLabel = Instance.new("TextLabel")
		titleLabel.BackgroundTransparency = 1
		titleLabel.Text = tostring(cfg.Title or "")
		titleLabel.Font = Enum.Font.GothamBold
		titleLabel.TextSize = 16
		titleLabel.AutomaticSize = Enum.AutomaticSize.XY
		titleLabel.Size = UDim2.fromOffset(0, 0)
		titleLabel.LayoutOrder = 2
		titleLabel.ZIndex = z + 1
		titleLabel.Parent = titleRow
		KazeUI:RegisterText(titleLabel, false)

		local subtitleLabel
		if cfg.Subtitle ~= nil then
			local subColor = CardColor(cfg.SubtitleColor)
			subtitleLabel = NewText(card, tostring(cfg.Subtitle), Enum.Font.GothamBold, 12, true, 3)
			subtitleLabel.Size = UDim2.new(1, 0, 0, 0)
			subtitleLabel.AutomaticSize = Enum.AutomaticSize.Y
			if subColor then subtitleLabel.TextColor3 = subColor end
		end

		if cfg.Content ~= nil and tostring(cfg.Content) ~= "" then
			local contentLabel = NewText(card, tostring(cfg.Content), Enum.Font.Gotham, 12, true, 4)
			contentLabel.Size = UDim2.new(1, 0, 0, 0)
			contentLabel.AutomaticSize = Enum.AutomaticSize.Y
		end

		local rows = {}
		if items then
			local scroll = NewScroller()
			scroll.Name = "CardItems"
			scroll.Size = UDim2.new(1, 0, 0, math.min(#items * 56, 224))
			scroll.BackgroundTransparency = 1
			scroll.BorderSizePixel = 0
			scroll.ScrollBarThickness = 3
			scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
			scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
			scroll.LayoutOrder = 5
			scroll.ZIndex = z + 1
			scroll.Parent = card
			local scrollList = Instance.new("UIListLayout", scroll)
			scrollList.SortOrder = Enum.SortOrder.LayoutOrder
			scrollList.Padding = UDim.new(0, 6)

			for i, it in ipairs(items) do
				local row = Instance.new("TextButton")
				row.Size = UDim2.new(1, -6, 0, 50)
				row.Text = ""
				row.AutoButtonColor = false
				row.BorderSizePixel = 0
				row.LayoutOrder = i
				row.ZIndex = z + 2
				row.Parent = scroll
				Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)
				KazeUI:AddPanel(row, 0.03)

				local thumb = Instance.new("ImageLabel")
				thumb.Position = UDim2.fromOffset(8, 6)
				thumb.Size = UDim2.fromOffset(38, 38)
				thumb.BackgroundTransparency = 1
				thumb.ScaleType = Enum.ScaleType.Crop
				thumb.Image = FormatImage(it.Image or "")
				thumb.ZIndex = z + 3
				thumb.Parent = row
				Instance.new("UICorner", thumb).CornerRadius = UDim.new(0, 8)

				local rowStatusColor = CardColor(it.SubtitleColor)
				local nameLeft = 54
				if rowStatusColor then
					local rowDot = Instance.new("Frame")
					rowDot.Position = UDim2.fromOffset(54, 11)
					rowDot.Size = UDim2.fromOffset(6, 6)
					rowDot.BackgroundColor3 = rowStatusColor
					rowDot.BorderSizePixel = 0
					rowDot.ZIndex = z + 3
					rowDot.Parent = row
					Instance.new("UICorner", rowDot).CornerRadius = UDim.new(1, 0)
					nameLeft = 64
				end

				local nameLabel = NewText(row, tostring(it.Title or ""), Enum.Font.GothamBold, 12, false, 0)
				nameLabel.Position = UDim2.fromOffset(nameLeft, 6)
				nameLabel.Size = UDim2.new(1, -nameLeft - 8, 0, 18)
				nameLabel.TextXAlignment = Enum.TextXAlignment.Left
				nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
				nameLabel.ZIndex = z + 3

				local statusLabel = NewText(row, tostring(it.Subtitle or ""), Enum.Font.Gotham, 11, true, 0)
				statusLabel.Position = UDim2.fromOffset(nameLeft, 26)
				statusLabel.Size = UDim2.new(1, -nameLeft - 8, 0, 16)
				statusLabel.TextXAlignment = Enum.TextXAlignment.Left
				statusLabel.TextTruncate = Enum.TextTruncate.AtEnd
				statusLabel.ZIndex = z + 3
				if rowStatusColor then statusLabel.TextColor3 = rowStatusColor end

				row.MouseEnter:Connect(function()
					TweenService:Create(row, TWEEN_FAST, {BackgroundColor3 = KazeUI.GetColor(0.06)}):Play()
				end)
				row.MouseLeave:Connect(function()
					TweenService:Create(row, TWEEN_FAST, {BackgroundColor3 = KazeUI.GetColor(0.03)}):Play()
				end)
				row.MouseButton1Click:Connect(function()
					if typeof(it.OnClick) == "function" then task.spawn(it.OnClick) end
				end)

				rows[i] = { Image = thumb, Title = nameLabel, Subtitle = statusLabel }
			end
		end

		local actionsFrame = Instance.new("Frame")
		actionsFrame.Size = UDim2.new(1, 0, 0, 34)
		actionsFrame.BackgroundTransparency = 1
		actionsFrame.LayoutOrder = 6
		actionsFrame.ZIndex = z + 1
		actionsFrame.Parent = card
		local actionsLayout = Instance.new("UIListLayout", actionsFrame)
		actionsLayout.FillDirection = Enum.FillDirection.Horizontal
		actionsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		actionsLayout.SortOrder = Enum.SortOrder.LayoutOrder
		actionsLayout.Padding = UDim.new(0, 8)

		local closed = false
		local function closeCard()
			if closed then return end
			closed = true
			if depth == 1 then
				TweenService:Create(InteractionBlocker, TWEEN_FAST, {BackgroundTransparency = 1}):Play()
			elseif shield then
				TweenService:Create(shield, TWEEN_FAST, {BackgroundTransparency = 1}):Play()
			end
			TweenService:Create(card, TWEEN_FAST, {Position = UDim2.fromScale(0.5, 0.45)}):Play()
			task.wait(TWEEN_FAST.Time)
			card:Destroy()
			if shield then shield:Destroy() end
			if depth == 1 then InteractionBlocker.Visible = false end
			cardDepth = math.max(0, cardDepth - 1)
			activeDialogsCount = math.max(0, activeDialogsCount - 1)
		end

		local n = #actions
		for i, act in ipairs(actions) do
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1 / n, -math.floor(8 * (n - 1) / n), 0, 34)
			btn.AutoButtonColor = false
			btn.Text = ""
			btn.BorderSizePixel = 0
			btn.LayoutOrder = i
			btn.ZIndex = z + 2
			btn.Parent = actionsFrame
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

			local btnText = Instance.new("TextLabel")
			btnText.Size = UDim2.new(1, -12, 1, 0)
			btnText.Position = UDim2.fromOffset(6, 0)
			btnText.BackgroundTransparency = 1
			btnText.Text = tostring(act.Name or "Button")
			btnText.Font = Enum.Font.GothamBold
			btnText.TextSize = 12
			btnText.ZIndex = z + 3
			btnText.Parent = btn

			local btnColor = CardColor(act.Color)
			if btnColor then
				btn.BackgroundColor3 = btnColor
				btnText.TextColor3 = Color3.fromRGB(255, 255, 255)
				btn.MouseEnter:Connect(function()
					local h, sat, v = Color3.toHSV(btnColor)
					TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = Color3.fromHSV(h, sat, math.clamp(v - 0.1, 0, 1))}):Play()
				end)
				btn.MouseLeave:Connect(function()
					TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = btnColor}):Play()
				end)
			else
				KazeUI:AddPanel(btn, 0.04)
				KazeUI:RegisterText(btnText, false)
				btn.MouseEnter:Connect(function()
					TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = KazeUI.GetColor(0.06)}):Play()
				end)
				btn.MouseLeave:Connect(function()
					TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = KazeUI.GetColor(0.04)}):Play()
				end)
			end

			btn.MouseButton1Click:Connect(function()
				if typeof(act.Callback) == "function" then task.spawn(act.Callback) end
				if not act.Keep then closeCard() end
			end)
		end

		return {
			Close = closeCard,
			Image = imageLabel,
			Title = titleLabel,
			Subtitle = subtitleLabel,
			Rows = rows
		}
	end

	function Win:CreateConfigManager(tab)
		local sec = tab:SectionUI("Config Manager")
		local cfgName = "Default"

		local function getConfigs()
			local list = {}
			local folder = KazeUI.AuthorName

			if makefolder then
				pcall(function()
					if isfolder and not isfolder(folder) then makefolder(folder)
					elseif not isfolder then makefolder(folder) end
