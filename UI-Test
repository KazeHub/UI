local function UpdateScale()
	local camera = workspace.CurrentCamera
	if not camera then return end -- camera can be briefly nil around respawn/teleport; skip this tick, the next ViewportSize/CurrentCamera change will re-run it

	local size = camera.ViewportSize
	local width, height = size.X, size.Y
	local minAxis = math.min(width, height)
	local targetScale = 1.0

	if UIS.TouchEnabled then
		targetScale = (minAxis < 500) and 0.85 or 1.0
	else
		if width >= 1920 or height >= 1080 then
			targetScale = 1.12
		elseif width <= 1366 then
			targetScale = 0.95
		else
			targetScale = 1.0
		end
	end

	if UIScale.Scale ~= targetScale then
		UIScale.Scale = targetScale
		OpenButtonScale.Scale = targetScale
		DialogScale.Scale = targetScale
		NotifScale.Scale = targetScale
	end

	ScreenGui.IgnoreGuiInset = true
	OpenButtonGui.IgnoreGuiInset = true
	DialogGui.IgnoreGuiInset = true
	NotifScreenGui.IgnoreGuiInset = true
end

-- Camera lifecycle: `workspace.CurrentCamera` can be nil momentarily and can
-- be REPLACED outright (character respawn, teleport, certain camera scripts
-- swapping it) -- the old code connected to the ViewportSize of whatever
-- camera existed at load time and never noticed if that camera object was
-- later swapped out, silently going stale. We now track the camera-specific
-- connection separately from the "camera changed" connection so both can be
-- torn down cleanly, and we reconnect automatically whenever the camera itself
-- changes.
local viewportConn = nil
local function RewireCameraListener()
	if viewportConn then
		viewportConn:Disconnect()
		viewportConn = nil
	end
	local camera = workspace.CurrentCamera
	if camera then
		viewportConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale)
	end
	UpdateScale()
end

RewireCameraListener()
local cameraChangedConn = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(RewireCameraListener)

local IconsMap = {}
pcall(function()
	if game and game.HttpGet then
		local rawIcons = game:HttpGet("https://raw.githubusercontent.com/KazeHub/UI/refs/heads/main/Icons.lua.txt")
		if rawIcons then
			-- Remote loading safety: try structured JSON first and only fall
			-- back to executing the fetched text as Lua if it genuinely isn't
			-- JSON. This used to be the other way around -- `loadstring` ran
			-- unconditionally on every load before JSON was ever attempted,
			-- executing whatever came back from the URL with no validation.
			-- The loadstring fallback is kept (not removed) so an icon file
			-- published as plain Lua still keeps working.
			local s, res = pcall(function() return HttpService:JSONDecode(rawIcons) end)
			if not s or type(res) ~= "table" then
				s, res = pcall(function()
					local func = loadstring(rawIcons)
					return func and func()
				end)
			end
			if type(res) == "table" then
				for k, v in pairs(res) do IconsMap[string.lower(tostring(k))] = tostring(v) end
			end
		end
	end
end)

local function GetCustomAssetFromURL(url, ext)
	local getasset = (getcustomasset or getsynasset or (drawing and drawing.new and drawing.custom_asset))
	if not getasset or not writefile or not game or not game.HttpGet then
		return url
	end

	ext = ext or "png"
	local hashName = string.gsub(url, "%W", "")
	local filename = "KazeUI/Cache/" .. string.sub(hashName, 1, 30) .. "." .. ext

	if isfile and isfile(filename) then
		local s, asset = pcall(getasset, filename)
		if s and asset then return asset end
	end

	local success, bytes = pcall(function()
		return game:HttpGet(url)
	end)

	if success and bytes and string.len(bytes) > 0 then
		if makefolder then
			pcall(makefolder, "KazeUI")
			pcall(makefolder, "KazeUI/Cache")
		end
		pcall(writefile, filename, bytes)
		local s, asset = pcall(getasset, filename)
		if s and asset then return asset end
	end

	return url
end

local function FormatImageUncached(id)
	if not id or id == "" then return "" end
	id = tostring(id)
	local lowerId = string.lower(id)

	local function track(result)
		if result and result ~= "" then
			KazeUI._PreloadSet[result] = true
		end
		return result
	end

	if IconsMap[lowerId] then
		local mapped = IconsMap[lowerId]
		if not string.find(mapped, "rbxassetid://") and not string.find(mapped, "http") then
			local clean = string.gsub(mapped, "%D", "")
			if clean ~= "" then return track("rbxassetid://" .. clean) end
		end
		return track(mapped)
	end

	if string.find(id, "rbxassetid://") then return track(id) end

	if string.find(id, "rbxthumb://") then return track(id) end

	if string.find(id, "^http://") or string.find(id, "^https://") then
		return track(GetCustomAssetFromURL(id))
	end

	local clean = string.gsub(id, "%D", "")
	if clean == "" then return id end
	return track("rbxassetid://" .. clean)
end

local FormatImageCache = {}
local function FormatImage(id)
	if not id or id == "" then return "" end
	id = tostring(id)
	local cached = FormatImageCache[id]
	if cached ~= nil then return cached end
	local result = FormatImageUncached(id)
	local isUrl = string.find(id, "^http://") or string.find(id, "^https://")
	if not isUrl or result ~= id then
		FormatImageCache[id] = result
	end
	return result
end

local function ApplyWallpaper(theme)
	theme = theme or KazeUI.CurrentTheme
	if not theme then return end

	local bgImgId = theme.BackgroundImage or ""
	local bgImgTrans = theme.BackgroundImageTransparency or 1
	local bgOverlayTrans = theme.OverlayTransparency or 0.25
	local hasImage = (bgImgId ~= "") and (bgImgTrans < 1) and not KazeUI.PerformanceMode

	local formatted = hasImage and FormatImage(bgImgId) or nil
	local imgTarget = hasImage and bgImgTrans or 1
	local overlayTarget = hasImage and bgOverlayTrans or 1

	for _, wp in ipairs(KazeUI.WallpaperElements) do
		local img = wp.ImageLabel
		if img and img.Parent then
			if hasImage and img.Image ~= formatted then
				img.Image = formatted
			end
			if math.abs(img.ImageTransparency - imgTarget) > 0.001 then
				TweenService:Create(img, TWEEN_SMOOTH, {ImageTransparency = imgTarget}):Play()
			end
			local overlay = wp.OverlayFrame
			if overlay and math.abs(overlay.BackgroundTransparency - overlayTarget) > 0.001 then
				TweenService:Create(overlay, TWEEN_SMOOTH, {BackgroundTransparency = overlayTarget}):Play()
			end
		end
	end
end

