local function RGBTitleStep()
	local n = #RGBTitles
	if n == 0 then return false end
	local color = Color3.fromHSV((tick() % 4) / 4, 0.8, 1)
	for i = n, 1, -1 do
		local e = RGBTitles[i]
		local label = e.Label
		if label and label.Parent then
			label.TextColor3 = color
			local icon = e.Icon
			if icon and icon.Parent then icon.ImageColor3 = color end
		else
			table.remove(RGBTitles, i)
		end
	end
	if #RGBTitles == 0 then return false end
end

