			KazeUI:SetGlow(Color3.fromRGB(239, 68, 68))
			KazeUI:SetGlowRainbow(true)
		else
			KazeUI:SetGlow(Color3.fromRGB(239, 68, 68))
		end
	else
		KazeUI:SetGlow(Color3.fromRGB(239, 68, 68))
	end

	local glowStyleVal = config.GlowStyle or config.GlowMode
	if type(glowStyleVal) == "string" then
		KazeUI:SetGlowMode(glowStyleVal)
	end

	if type(config.GlowRainbow) == "boolean" then
		KazeUI:SetGlowRainbow(config.GlowRainbow)
	end

	if type(config.PerformanceMode) == "boolean" then
		KazeUI.PerformanceMode = config.PerformanceMode
	elseif type(config.Lite) == "boolean" then
		KazeUI.PerformanceMode = config.Lite
	end

	ApplyTweenProfile(KazeUI.PerformanceMode)
	if KazeUI.PerformanceMode then
		-- Same restore-key bookkeeping as runtime SetPerformanceMode(true): the
		-- developer may have also passed config.Theme, so remember what they
		-- actually asked for before forcing Obsidian, otherwise a later
		-- SetPerformanceMode(false) call has nothing to restore to.
		if selectedTheme ~= "Obsidian" then
			KazeUI._PrePerformanceThemeKey = selectedTheme
		end
		selectedTheme = "Obsidian"
	end

	local initialSize = config.Size or UDim2.fromOffset(600, 400)
	local MiniButtonSize = (config.OpenButton and config.OpenButton.Size) or UDim2.fromOffset(48, 48)

	local openButtonHidable = true
	if config.OpenButton and config.OpenButton.Hidable ~= nil then
		openButtonHidable = config.OpenButton.Hidable and true or false
	end

	local Window = Instance.new("Frame")
	Window.Size = initialSize
	Window.Position = UDim2.fromScale(0.5, 0.5)
	Window.AnchorPoint = Vector2.new(0.5, 0.5)
	Window.BorderSizePixel = 0
	Window.Active = true
	Window.Parent = ScreenGui

	Instance.new("UICorner", Window).CornerRadius = UDim.new(0, 28)
	KazeUI:AddPanel(Window, 0)
	SetLoadingProgress(50, "Building interface")

	local outerShadow = Instance.new("Frame", Window)
