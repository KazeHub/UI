	local isMinimized = false

	local function computeCenterGrowStart(anchorPoint, finalPos, finalSize)
		local shiftScale = (0.5 - anchorPoint.Y) * finalSize.Y.Scale
		local shiftOffset = (0.5 - anchorPoint.Y) * finalSize.Y.Offset
		local startPos = UDim2.new(finalPos.X.Scale, finalPos.X.Offset, finalPos.Y.Scale + shiftScale, finalPos.Y.Offset + shiftOffset)
		local startSize = UDim2.new(finalSize.X.Scale, finalSize.X.Offset, 0, 2)
		return startPos, startSize
	end

	local function minimizeWindow()
		if isMinimized then return end
		isMinimized = true

		if not toggledMaximized then
			dragState.Position = Window.Position
			dragState.Anchor = Window.AnchorPoint
		end

		local collapsePos, collapseSize = computeCenterGrowStart(Window.AnchorPoint, Window.Position, Window.Size)
		local closeTween = TweenService:Create(Window, TWEEN_SPRING, {Position = collapsePos, Size = collapseSize})
		closeTween.Completed:Connect(function()
			if isMinimized then
				Window.Visible = false
			end
		end)
		closeTween:Play()

		if openButtonHidable then
			MiniButton.Visible = true
			MiniButton.Size = UDim2.fromOffset(0, 0)
			TweenService:Create(MiniButton, TWEEN_SPRING, {Size = MiniButtonSize}):Play()
