-- Repeated initialization: if the loader (`loadstring(game:HttpGet(...))()`)
-- gets executed again -- re-running the exploit menu, a hot-reload, whatever
-- -- the whole module re-runs from scratch and used to just create a second
-- full set of ScreenGuis on top of the first, leaving the old instance's
-- RunService loops, UIS connections, and camera listener running forever
-- alongside the new one. Destroy any prior instance owned by this library
-- (identified by the same fixed names it always creates) before building a
-- new one; each old ScreenGui already wires `Destroying:Connect(ShutdownRuntime)`
-- (see below), so destroying it tears down that old instance's own runtime
-- connections too.
for _, guiName in ipairs({"KazeUI", "KazeUI_OpenButton", "KazeUI_Dialogs", "KazeUINotifications"}) do
	local existing = parent:FindFirstChild(guiName)
	if existing then
		existing:Destroy()
	end
end

