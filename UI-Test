		local scale = UIScale.Scale

		local newWidth = math.floor(math.clamp(resizeStartSize.X + (delta.X / scale), minWidth, maxWidth) + 0.5)
		local newHeight = math.floor(math.clamp(resizeStartSize.Y + (delta.Y / scale), minHeight, maxHeight) + 0.5)

		local cur = Window.Size
		if cur.X.Scale ~= 0 or cur.Y.Scale ~= 0 or cur.X.Offset ~= newWidth or cur.Y.Offset ~= newHeight then
			Window.Size = UDim2.fromOffset(newWidth, newHeight)
		end
		lastNormalSize = Window.Size
	end

