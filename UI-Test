local PRESS_DRAG_CANCEL_DISTANCE = 10

local function BindPressAnimation(clickDetector, canPress, applyPressed, applyReleased, onActivate)
	local pressed = false
	local startPos = Vector2.new()
	local moveCon, endCon

	local function cleanup()
		if moveCon then moveCon:Disconnect(); moveCon = nil end
		if endCon then endCon:Disconnect(); endCon = nil end
	end

	local function release()
		if not pressed then return end
		pressed = false
		cleanup()
		applyReleased()
	end

	clickDetector.MouseButton1Down:Connect(function(x, y)
		if canPress and not canPress() then return end
		pressed = true
		startPos = Vector2.new(x, y)
		applyPressed()

		cleanup()
		moveCon = UIS.InputChanged:Connect(function(input)
			if not pressed then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				local pos = input.Position
				if (Vector2.new(pos.X, pos.Y) - startPos).Magnitude > PRESS_DRAG_CANCEL_DISTANCE then
					release()
				end
			end
		end)
		endCon = UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				release()
			end
		end)
	end)

	if onActivate then
		clickDetector.MouseButton1Click:Connect(function()
			if canPress and not canPress() then return end
			onActivate()
		end)
	end
end

local function BindTouchLeaveFix(control, isHoveringGetter, onLeave)
	control.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			task.defer(function()
				if isHoveringGetter() then
					onLeave()
				end
			end)
		end
	end)
end

