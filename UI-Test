	local listLayout = Instance.new("UIListLayout", listContainer)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 4)

	local optionItems = {}
	local itemsStale = true

	local function CalcHeight()
		local count = 0
		for _, item in ipairs(optionItems) do if item.Btn.Visible then count = count + 1 end end
		local targetH = math.min(count, 5) * 34
		TweenService:Create(listContainer, TWEEN_FAST, {Size = UDim2.new(1, -20, 0, targetH)}):Play()
		listContainer.CanvasSize = UDim2.new(0, 0, 0, count * 34)
	end

	local function CloseDropdown()
		isOpen = false
		searchBox.Text = ""
		searchWrapper.Visible = false
		listContainer.Visible = false
		TweenService:Create(arrowIcon, TWEEN_SPRING, {Rotation = 0}):Play()
		StopNeonLoop(boxStroke)
		TweenService:Create(boxStroke, TWEEN_FAST, {Color = KazeUI.CurrentTheme.Border}):Play()
	end

	local function OptionListUnchanged(nextOptions)
		if #nextOptions ~= #options then return false end
		for i = 1, #options do
			if tostring(options[i]) ~= tostring(nextOptions[i]) then return false end
		end
		return true
	end

	local function Refresh(newOptions)
		local nextOptions = type(newOptions) == "table" and newOptions or {}
		-- Skip destroying/recreating every option button when the content hasn't
		-- actually changed (e.g. a player-list refresh firing with no real
		-- change, or "Refresh" clicked twice) -- this used to unconditionally
		-- rebuild the whole list every single call.
		if not itemsStale and OptionListUnchanged(nextOptions) then
			options = nextOptions
			return
		end

		for _, item in ipairs(optionItems) do item.Btn:Destroy() end
		table.clear(optionItems)
		itemsStale = false

		options = nextOptions
		for _, opt in ipairs(options) do
			local optStr = tostring(opt)
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -4, 0, 30)
			btn.BorderSizePixel = 0
			btn.Text = "  " .. optStr
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 11
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.Parent = listContainer
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

			KazeUI:AddPanel(btn, 0.03, true)

			local indicator
			if isMulti then
				indicator = Instance.new("Frame", btn)
				indicator.AnchorPoint = Vector2.new(1, 0.5)
				indicator.Position = UDim2.new(1, -10, 0.5, 0)
				indicator.Size = UDim2.fromOffset(12, 12)
				local indStroke = Instance.new("UIStroke", indicator)
				KazeUI:RegisterBorder(indStroke)
				Instance.new("UICorner", indicator).CornerRadius = UDim.new(0, 4)
				KazeUI:AddPanel(indicator, 0.04)
			end

			local isHovering = false
			local currentBgTween, currentTxtTween
			local lastBg, lastTxt, lastInd

			local function UpdateVisuals(instant)
				local active = isMulti and selectedMulti[optStr] or (not isMulti and selectedSingle == optStr)

				local targetBg = active and KazeUI.GetColor(0.06) or KazeUI.GetColor(0.03)
				local targetTxt = active and KazeUI.CurrentTheme.Text or KazeUI.CurrentTheme.MutedText
				local indTargetBg = active and KazeUI.GlowColor or KazeUI.GetColor(0.03)

				if isHovering then
					targetBg = KazeUI.GetColor(0.08)
					targetTxt = KazeUI.CurrentTheme.Text
				end

				if targetBg == lastBg and targetTxt == lastTxt and indTargetBg == lastInd then return end
				lastBg, lastTxt, lastInd = targetBg, targetTxt, indTargetBg

				if currentBgTween then currentBgTween:Cancel() currentBgTween = nil end
				if currentTxtTween then currentTxtTween:Cancel() currentTxtTween = nil end

				if instant then
					btn.BackgroundColor3 = targetBg
					btn.TextColor3 = targetTxt
					if isMulti and indicator then indicator.BackgroundColor3 = indTargetBg end
				else
					currentBgTween = TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = targetBg})
					currentTxtTween = TweenService:Create(btn, TWEEN_FAST, {TextColor3 = targetTxt})
					currentBgTween:Play()
					currentTxtTween:Play()

					if isMulti and indicator then
						TweenService:Create(indicator, TWEEN_FAST, {BackgroundColor3 = indTargetBg}):Play()
					end
				end
			end
			UpdateVisuals(true)

			KazeUI:OnThemeChanged(btn, function()
				UpdateVisuals(true)
			end)

			btn.MouseEnter:Connect(function()
				if isLockedState or activeDialogsCount > 0 then return end
				isHovering = true
				UpdateVisuals(false)
			end)
			btn.MouseLeave:Connect(function()
				isHovering = false
				UpdateVisuals(false)
			end)

			btn.MouseButton1Click:Connect(function()
				if isLockedState or activeDialogsCount > 0 then return end
				TweenService:Create(btn, TWEEN_PRESS_SHORT, {Size = UDim2.new(1, -8, 0, 28)}):Play()

				if isMulti then
					selectedMulti[optStr] = not selectedMulti[optStr]
					UpdateVisuals(false)
					UpdateHeaderVisual()
					FireCallback(callback, CollectMultiSelection(selectedMulti))
				else
					selectedSingle = optStr
					UpdateHeaderVisual()
					CloseDropdown()
					for _, item in ipairs(optionItems) do item.Update(false) end
					FireCallback(callback, selectedSingle)
				end
			end)

			table.insert(optionItems, { Btn = btn, Text = optStr, Update = function(instant) UpdateVisuals(instant) end })

			if isMulti then
				KazeUI:OnGlowChanged(btn, function() UpdateVisuals(true) end)
			end
		end
		CalcHeight()
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		if isLockedState or activeDialogsCount > 0 then return end
		local q = string.lower(searchBox.Text)
		for _, item in ipairs(optionItems) do
			item.Btn.Visible = (q == "" or string.find(string.lower(item.Text), q, 1, true)) ~= nil
		end
		CalcHeight()
	end)

	clickBtn.MouseButton1Click:Connect(function()
		if isLockedState or activeDialogsCount > 0 then return end
		isOpen = not isOpen
		if isOpen then
			searchWrapper.Visible = true
			listContainer.Visible = true
			if itemsStale then Refresh(options) else CalcHeight() end
			TweenService:Create(arrowIcon, TWEEN_SPRING, {Rotation = 180}):Play()
			StartNeonLoop(boxStroke)
		else
			CloseDropdown()
		end
	end)

	local function ApplySelection(val)
		if isMulti then
			selectedMulti = {}
			if type(val) == "table" then
				for _, v in ipairs(val) do selectedMulti[tostring(v)] = true end
			end
		else
			selectedSingle = tostring(val)
		end
		UpdateHeaderVisual()
		for _, item in ipairs(optionItems) do item.Update(true) end
		if isMulti then
			FireCallback(callback, CollectMultiSelection(selectedMulti))
		else
			FireCallback(callback, selectedSingle)
		end
	end

	RegisterFlag(flag, function()
		if isMulti then return CollectMultiSelection(selectedMulti) end
		return selectedSingle
	end, ApplySelection)

	local lockCtrl = ApplyLock(dropFrame, locked, wrapper, UDim2.new(0.95, 0, 1, -3), UDim2.new(0.5, 0, 0, 3), Vector2.new(0.5, 0))

	if playerList then
		WirePlayerListRefresh(wrapper, function(opts)
			local prev, cur = {}, {}
			for _, o in ipairs(options) do prev[tostring(o)] = true end
			for _, o in ipairs(opts) do cur[tostring(o)] = true end
			if isMulti then
				for k in pairs(selectedMulti) do
					if prev[k] and not cur[k] then selectedMulti[k] = nil end
				end
			elseif prev[selectedSingle] and not cur[selectedSingle] then
				selectedSingle = ""
			end
			UpdateHeaderVisual()
			if isOpen then
				Refresh(opts)
			else
				options = opts
				itemsStale = true
			end
		end, false, playerListInterval)
	end

	return FinishElement({
		Wrapper = wrapper,
		Frame = dropFrame,
		Refresh = function(self, newOpts) Refresh(newOpts) end,
		GetValue = function()
			if isMulti then return CollectMultiSelection(selectedMulti) end
			return selectedSingle
		end,
		SetText = function(self, newTitle) titleLabel.Text = newTitle end,
		SetLocked = function(self, state)
			isLockedState = state
			lockCtrl:SetLocked(state)
		end,
		SetValue = function(self, val) ApplySelection(val) end,
		OnChanged = function(self, fn) callback = ChainCallback(callback, fn) end
	}, flag)
end

