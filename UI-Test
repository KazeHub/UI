function KazeUI.GetColor(elevation)
	local theme = KazeUI.CurrentTheme
	local h, s, v = Color3.toHSV(theme.Background)
	local factor = theme.LightnessFactor or 1
	local offset = elevation * factor * 2.2
	local targetS = math.clamp(s - (elevation * 0.5), 0, 1)
	local targetV = math.clamp(v + offset, 0, 1)
	return Color3.fromHSV(h, targetS, targetV)
end

function KazeUI:AddPanel(inst, elevation, ignoreColorUpdate, ignoreTransparencyUpdate)
	table.insert(KazeUI.PanelElements, {
		Inst = inst,
		Elevation = elevation or 0,
		IgnoreColor = ignoreColorUpdate,
		IgnoreTransparency = ignoreTransparencyUpdate
	})
	if inst and inst:IsA("GuiObject") then
		if not ignoreColorUpdate then
			inst.BackgroundColor3 = KazeUI.GetColor(elevation or 0)
		end

		if not ignoreTransparencyUpdate then
			local baseTrans = KazeUI.BackgroundTransparency or 0.70
			if elevation and elevation > 0 then
				baseTrans = math.clamp(baseTrans - (elevation * 0.25), 0.05, 1)
			elseif elevation and elevation < 0 then
				baseTrans = math.clamp(baseTrans + (math.abs(elevation) * 0.25), 0.05, 1)
			end
			inst.BackgroundTransparency = baseTrans
		end

		inst.Destroying:Connect(function()
			for i = #KazeUI.PanelElements, 1, -1 do
				if KazeUI.PanelElements[i].Inst == inst then table.remove(KazeUI.PanelElements, i) end
			end
		end)
	end
end

function KazeUI:SetBackgroundColor(color)
	if typeof(color) ~= "Color3" then return end

	-- The `color` argument used to be dropped entirely: every panel was
	-- re-shaded from KazeUI.CurrentTheme.Background (unchanged), so calling
	-- this with a custom color had no visible effect. KazeUI.GetColor derives
	-- every panel's elevation shade from KazeUI.CurrentTheme.Background, so to
	-- make a custom color actually take effect (and stay in effect for any
	-- panel added afterwards via AddPanel), update that source value too --
	-- the same thing SetTheme already does when it hands SetBackgroundColor a
	-- theme's background color.
	KazeUI.BackgroundColor = color
	if KazeUI.CurrentTheme then
		KazeUI.CurrentTheme.Background = color
	end

	for _, data in ipairs(KazeUI.PanelElements) do
		if data.Inst and data.Inst.Parent and data.Inst:IsA("GuiObject") and not data.IgnoreColor then
			data.Inst.BackgroundColor3 = KazeUI.GetColor(data.Elevation)
		end
	end
end

function KazeUI:SetTransparency(alpha)
	KazeUI.BackgroundTransparency = alpha
	for _, data in ipairs(KazeUI.PanelElements) do
		local inst = data.Inst
		local elevation = data.Elevation or 0
		if inst and inst.Parent and inst:IsA("GuiObject") and not data.IgnoreTransparency then
			local baseTrans = alpha
			if elevation > 0 then
				baseTrans = math.clamp(alpha - (elevation * 0.25), 0.05, 1)
			elseif elevation < 0 then
				baseTrans = math.clamp(alpha + (math.abs(elevation) * 0.25), 0.05, 1)
			end
			inst.BackgroundTransparency = baseTrans
		end
	end
end

function KazeUI:SetTheme(themeName)
	local targetTheme = KazeUI.Themes[themeName]

	if not targetTheme and type(themeName) == "string" and (string.find(themeName, "^http://") or string.find(themeName, "^https://")) then

		KazeUI.Themes.CustomWallpaper.BackgroundImage = themeName
		KazeUI.Themes.CustomWallpaper.BackgroundImageTransparency = 0.1
		KazeUI.Themes.CustomWallpaper.OverlayTransparency = 0.65
		targetTheme = KazeUI.Themes.CustomWallpaper

		local themeUrl = themeName
		task.spawn(function()
			local success, rawTheme = pcall(function()
				return game:HttpGet(themeUrl)
			end)
			if not (success and rawTheme) then return end

			local themeTable = nil
			local s, parsed = pcall(function()
				return HttpService:JSONDecode(rawTheme)
			end)
			if s and type(parsed) == "table" then
				themeTable = parsed
			else
				local s2, func = pcall(loadstring, rawTheme)
				if s2 and func then
					local s3, res = pcall(func)
					if s3 and type(res) == "table" then
						themeTable = res
					end
				end
			end

			if not themeTable then return end

			local function parseColor(val)
				if typeof(val) == "Color3" then
					return val
				elseif type(val) == "string" then
					local cleanHex = string.gsub(val, "#", "")
					local s4, res = pcall(function() return Color3.fromHex(cleanHex) end)
					if s4 and res then return res end
				elseif type(val) == "table" then
					local r = val.r or val.R or val[1] or 0
					local g = val.g or val.G or val[2] or 0
					local b = val.b or val.B or val[3] or 0
					if r > 1 or g > 1 or b > 1 then
						return Color3.fromRGB(r, g, b)
					else
						return Color3.new(r, g, b)
					end
				end
				return nil
			end

			KazeUI.Themes.CustomWallpaper.Background = parseColor(themeTable.Background) or Color3.fromRGB(12, 12, 14)
			KazeUI.Themes.CustomWallpaper.Text = parseColor(themeTable.Text) or Color3.fromRGB(255, 255, 255)
			KazeUI.Themes.CustomWallpaper.MutedText = parseColor(themeTable.MutedText) or Color3.fromRGB(215, 210, 225)
			KazeUI.Themes.CustomWallpaper.Border = parseColor(themeTable.Border) or Color3.fromRGB(55, 55, 60)
			KazeUI.Themes.CustomWallpaper.LightnessFactor = tonumber(themeTable.LightnessFactor) or 1
			KazeUI.Themes.CustomWallpaper.BackgroundImage = tostring(themeTable.BackgroundImage or themeUrl)
			KazeUI.Themes.CustomWallpaper.BackgroundImageTransparency = tonumber(themeTable.BackgroundImageTransparency) or 0.1
			KazeUI.Themes.CustomWallpaper.OverlayTransparency = tonumber(themeTable.OverlayTransparency) or 0.65

			if KazeUI.CurrentTheme == KazeUI.Themes.CustomWallpaper then
				KazeUI:SetTheme("CustomWallpaper")
			end
		end)
	end

	targetTheme = targetTheme or KazeUI.Themes[themeName] or KazeUI.Themes.CustomWallpaper
	KazeUI.CurrentTheme = targetTheme
	-- Track the actual Themes[] key (not just the table), so code like Performance
	-- Mode can save "what theme was selected" and later restore it by name --
	-- the table alone isn't enough since a raw wallpaper URL and the
	-- "CustomWallpaper" key both resolve to the same table.
	KazeUI.CurrentThemeKey = KazeUI.Themes[themeName] and themeName or "CustomWallpaper"
	KazeUI.BackgroundColor = targetTheme.Background

	KazeUI:SetBackgroundColor(targetTheme.Background)
	KazeUI:SetTransparency(targetTheme.PanelTransparency or KazeUI.BackgroundTransparency or 0.70)

	if themeName == "Obsidian" and not KazeUI._userSetGlow then
		KazeUI:SetGlow(Color3.fromRGB(255, 255, 255))
	end

	for _, inst in ipairs(KazeUI.TextElements) do
		if inst and inst.Parent then inst.TextColor3 = targetTheme.Text end
	end
	for _, inst in ipairs(KazeUI.MutedTextElements) do
		if inst and inst.Parent then
			inst.TextColor3 = targetTheme.MutedText
			if inst:IsA("TextBox") then inst.PlaceholderColor3 = targetTheme.MutedText end
		end
	end
	for _, inst in ipairs(KazeUI.BorderElements) do
		if inst and inst.Parent then inst.Color = targetTheme.Border end
	end

	ApplyWallpaper(targetTheme)

	for _, data in ipairs(KazeUI.ThemeCallbacks) do
		if data.Inst and data.Inst.Parent then pcall(data.Callback, targetTheme) end
	end
end

local GLOW_BREATHE_PERIOD = 4.0

local GLOW_SEQUENCE_PERIOD = 6.0
local GLOW_SEQUENCE_STOPS = {0, 45, -40, 85}
local GLOW_SEQUENCE_RAINBOW_STOPS = {0, 90, 180, 270}
local GLOW_SEQUENCE_ROTATE_SECONDS = 3.5

local GLOW_PULSE_ATTACK = 0.16
local GLOW_PULSE_DECAY = 0.85

local GLOW_CHASE_PERIOD = 2.2
local GLOW_CHASE_STAGGER = 0.09
local GLOW_CHASE_WIDTH = 2.6

local GLOW_RAINBOW_BREATHE_SPEED = 40

local glowClock = 0

local function BuildGlowGradientSequence()
	local baseH = Color3.toHSV(KazeUI.GlowColor)
	local baseS, baseV = 1, 1

	local keypoints = {}
	if KazeUI.GlowRainbow then

		local stopCount = 7
		for i = 0, stopCount - 1 do
			local alpha = i / (stopCount - 1)
			local hue = (baseH + alpha) % 1
			table.insert(keypoints, ColorSequenceKeypoint.new(alpha, Color3.fromHSV(hue, baseS, baseV)))
		end
	else

		local spreadDeg = 70
		local offsets = {-1, -0.5, 0, 0.5, 1}
		for i, mult in ipairs(offsets) do
			local alpha = (i - 1) / (#offsets - 1)
			local hue = (baseH + (mult * spreadDeg) / 360) % 1
			table.insert(keypoints, ColorSequenceKeypoint.new(alpha, Color3.fromHSV(hue, baseS, baseV)))
		end
	end
	return ColorSequence.new(keypoints)
end

local GLOW_RING_COLORSEQUENCE = BuildGlowGradientSequence()

local function RefreshGlowGradientSequence()
	GLOW_RING_COLORSEQUENCE = BuildGlowGradientSequence()
	for _, data in ipairs(KazeUI.GlowElements) do
		local target = data.Target
		if target and target.Parent then
			local grad = target:FindFirstChild("KazeGlowGradient")
			if grad then grad.Color = GLOW_RING_COLORSEQUENCE end
		end
	end
end

local function LerpHueShortest(hueA, hueB, alpha)
	local diff = (hueB - hueA + 1.5) % 1 - 0.5
	return (hueA + diff * alpha) % 1
end

local function EnsureGlowGradient(inst)
	local existing = inst:FindFirstChild("KazeGlowGradient")
	if existing then return existing end
	local ok, grad = pcall(function()
		local g = Instance.new("UIGradient")
		g.Name = "KazeGlowGradient"
		g.Color = GLOW_RING_COLORSEQUENCE
		g.Enabled = false
		g.Parent = inst
		return g
	end)
	if ok then return grad end
	return nil
end

local function ComputeGlowColor()
	local baseH = Color3.toHSV(KazeUI.GlowColor)
	local baseS, baseV = 1, 1

	if KazeUI.GlowMode == "Sequence" then
		local stops = KazeUI.GlowRainbow and GLOW_SEQUENCE_RAINBOW_STOPS or GLOW_SEQUENCE_STOPS
		local n = #stops
		local segDur = GLOW_SEQUENCE_PERIOD / n
		local raw = (glowClock % GLOW_SEQUENCE_PERIOD) / segDur
		local idx = math.floor(raw) + 1
		local nextIdx = (idx % n) + 1
		local frac = raw - math.floor(raw)
		local eased = frac * frac * (3 - 2 * frac)
		local hueA = (baseH * 360 + stops[idx]) / 360 % 1
		local hueB = (baseH * 360 + stops[nextIdx]) / 360 % 1
		local hue = LerpHueShortest(hueA, hueB, eased)
		local intensity = 0.7 + math.sin(eased * math.pi) * 0.3
		return Color3.fromHSV(hue, baseS, baseV), intensity

	elseif KazeUI.GlowMode == "Pulse" then
		local total = GLOW_PULSE_ATTACK + GLOW_PULSE_DECAY
		local phase = glowClock % total
		local envelope
		if phase < GLOW_PULSE_ATTACK then
			local t = phase / GLOW_PULSE_ATTACK
			envelope = t * t
		else
			local t = (phase - GLOW_PULSE_ATTACK) / GLOW_PULSE_DECAY
			envelope = 1 - (t * t)
		end
		local hue = baseH
		if KazeUI.GlowRainbow then
			hue = (glowClock * (GLOW_RAINBOW_BREATHE_SPEED / 360)) % 1
		end
		local troughV = baseV * 0.8
		local peakV = 1
		return Color3.fromHSV(hue, baseS, troughV + envelope * (peakV - troughV)), envelope

	else
		local hue = baseH
		if KazeUI.GlowRainbow then
			hue = (glowClock * (GLOW_RAINBOW_BREATHE_SPEED / 360)) % 1
		end
		local envelope = (math.sin((glowClock / GLOW_BREATHE_PERIOD) * math.pi * 2) + 1) / 2
		local troughV = baseV * 0.85
		local peakV = 1
		return Color3.fromHSV(hue, baseS, troughV + envelope * (peakV - troughV)), envelope
	end
end

local schedList = {}
local schedByKey = {}
local schedConn = nil
local schedStepping = false

local function SchedCompact()
	if schedList.Dirty then
		schedList.Dirty = nil
		for i = #schedList, 1, -1 do
			if schedList[i].Dead then table.remove(schedList, i) end
		end
	end
	if #schedList == 0 and schedConn then
		schedConn:Disconnect()
		schedConn = nil
	end
end

local function SchedStep(dt)
	schedStepping = true
	for i = #schedList, 1, -1 do
		local t = schedList[i]
		if t and not t.Dead then
			t.Acc = t.Acc + dt
			if t.Acc >= t.Interval then
				local elapsed = t.Acc
				t.Acc = 0
				local ok, result = pcall(t.Fn, elapsed)
				if not ok then
					t.Dead = true
					schedList.Dirty = true
					if schedByKey[t.Key] == t then schedByKey[t.Key] = nil end
				elseif result == false then
					t.Dead = true
					schedList.Dirty = true
					if schedByKey[t.Key] == t then schedByKey[t.Key] = nil end
				end
			end
		end
	end
	schedStepping = false
	SchedCompact()
end

local function SchedAdd(key, fn, interval)
	local t = schedByKey[key]
	if t and not t.Dead then
		t.Fn = fn
		t.Interval = interval
		return t
	end
	t = {Key = key, Fn = fn, Interval = interval, Acc = 0, Dead = false}
	schedByKey[key] = t
	table.insert(schedList, t)
	if not schedConn then
		schedConn = RunService.Heartbeat:Connect(SchedStep)
	end
	return t
end

local function SchedRemove(key)
	local t = schedByKey[key]
	if not t then return end
	t.Dead = true
	schedList.Dirty = true
	schedByKey[key] = nil
	if not schedStepping then SchedCompact() end
end

local GLOW_UPDATE_INTERVAL = 1 / 30
local GLOW_VISIBILITY_INTERVAL = 0.25
local GLOW_IDLE_POLL = 0.4

