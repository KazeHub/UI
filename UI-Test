local function RebuildGlowVisible()
	local list = KazeUI.GlowElements
	local n = #list
	local w = 0
	local vc = 0
	local prevLen = #glowVisData
	for r = 1, n do
		local data = list[r]
		local target = data.Target
		if target and target.Parent and not Destroyed[target] then
			w = w + 1
			if w ~= r then list[w] = data end
			if IsGlowTargetShown(target) then
				vc = vc + 1
				glowVisData[vc] = data
				glowVisIndex[vc] = w
			end
		elseif target then
			GlowTargetSet[target] = nil
		end
	end
	for i = n, w + 1, -1 do list[i] = nil end
	for i = prevLen, vc + 1, -1 do
		glowVisData[i] = nil
		glowVisIndex[i] = nil
	end
	glowVisCount = vc
end

local function ApplyGlowToElement(data, color, intensity, useRingGradient)
	local rings = data.HaloRings
	if rings then
		for i = 1, #rings do
			local ring = rings[i]
			local inst = ring.Instance
			if inst.Color ~= color then inst.Color = color end
			local t = ring.BaseTransparency - intensity * ring.IntensityBoost
			if t < 0.05 then t = 0.05 elseif t > 0.95 then t = 0.95 end
			if inst.Transparency ~= t then inst.Transparency = t end
		end
		return
	end

	local target = data.Target
	local grad = data.Grad
	if grad and not grad.Parent then
		grad = nil
		data.Grad = nil
	end

	if useRingGradient then
		if not grad then
			grad = EnsureGlowGradient(target)
			data.Grad = grad
		end
		if grad then
			if not grad.Enabled then grad.Enabled = true end
			grad.Rotation = (glowClock / GLOW_SEQUENCE_ROTATE_SECONDS * 360) % 360
			return
		end
	elseif not grad and not data.GradChecked then
		data.GradChecked = true
		grad = target:FindFirstChild("KazeGlowGradient")
		data.Grad = grad
	end

	if grad and grad.Enabled then grad.Enabled = false end
	local prop = data.Prop
	if target[prop] ~= color then target[prop] = color end
end

local function StartGlowPoll()
	if glowPoll then return end
	glowPoll = task.delay(GLOW_IDLE_POLL, GlowPollTick)
end

local function StepGlow(dt)
	if #KazeUI.GlowElements == 0 then
		return false
	end

	glowClock = glowClock + dt
	glowVisAccum = glowVisAccum + dt
	if glowDirty or glowVisAccum >= GLOW_VISIBILITY_INTERVAL then
		glowDirty = false
		glowVisAccum = 0
		RebuildGlowVisible()
		if #KazeUI.GlowElements == 0 then return false end
	end

	local vc = glowVisCount
	if vc == 0 then

		StartGlowPoll()
		return false
	end

	if KazeUI.GlowMode == "Chase" then
		local baseH = Color3.toHSV(KazeUI.GlowColor)
		local rainbow = KazeUI.GlowRainbow
		for k = 1, vc do
			local data = glowVisData[k]
			local idx = glowVisIndex[k]
			local phase = (glowClock - (idx - 1) * GLOW_CHASE_STAGGER) % GLOW_CHASE_PERIOD
			local t = phase / GLOW_CHASE_PERIOD
			local envelope = math.clamp(1 - math.abs(t - 0.5) * 2 * GLOW_CHASE_WIDTH, 0, 1)
			local hue = baseH
			if rainbow then
				hue = (glowClock * (GLOW_RAINBOW_BREATHE_SPEED / 360) - (idx - 1) * 0.015) % 1
			end
			ApplyGlowToElement(data, Color3.fromHSV(hue, 1, 0.8 + envelope * 0.2), envelope, false)
		end
		return
	end

	local color, intensity = ComputeGlowColor()
	local sequenceModeActive = (KazeUI.GlowMode == "Sequence")
	for k = 1, vc do
		local data = glowVisData[k]
		ApplyGlowToElement(data, color, intensity, sequenceModeActive and data.IsStrokeLike)
	end
end

GlowPollTick = function()
	glowPoll = nil
	glowDirty = false
	if #KazeUI.GlowElements == 0 then return end
	RebuildGlowVisible()
	if #KazeUI.GlowElements == 0 then return end
	if glowVisCount > 0 then
		SchedAdd("glow", StepGlow, GLOW_UPDATE_INTERVAL)
	else
		glowPoll = task.delay(GLOW_IDLE_POLL, GlowPollTick)
	end
end

local function GlowWake()
	glowDirty = true
	if glowPoll then
		task.cancel(glowPoll)
		glowPoll = nil
	end
	local t = schedByKey["glow"]
	if t and not t.Dead then
		t.Acc = t.Interval
	else
		SchedAdd("glow", StepGlow, GLOW_UPDATE_INTERVAL)
	end
end

local function GetColorProp(t) return t.Color end

local function StartNeonLoop(target)
	if not target then return end
	if GlowTargetSet[target] then return end
	local isStroke = pcall(GetColorProp, target)
	local propName = isStroke and "Color" or "BackgroundColor3"
	if KazeUI.PerformanceMode then
		target[propName] = KazeUI.GlowColor
		return
	end
	GlowTargetSet[target] = true
	TrackDestroy(target)
	table.insert(KazeUI.GlowElements, {Target = target, Prop = propName, IsStrokeLike = isStroke})
	GlowWake()
end

function KazeUI:AddGlowHalo(hostFrame, cornerRadius)
	if not hostFrame then return end
	local halo = Instance.new("Frame")
	halo.Name = "GlowHalo"
	halo.BackgroundTransparency = 1
	halo.Size = UDim2.new(1, 0, 1, 0)
	halo.Position = UDim2.fromScale(0.5, 0.5)
	halo.AnchorPoint = Vector2.new(0.5, 0.5)
	halo.ZIndex = math.max((hostFrame.ZIndex or 1) - 1, -50)
	halo.Parent = hostFrame

	local corner = Instance.new("UICorner", halo)
	corner.CornerRadius = cornerRadius or UDim.new(0, 28)

	local ringDefs = {
		{Thickness = 3, BaseTransparency = 0.35, IntensityBoost = 0.15},
		{Thickness = 10, BaseTransparency = 0.72, IntensityBoost = 0.26},
	}
	local rings = {}
	for _, def in ipairs(ringDefs) do
		local ring = Instance.new("UIStroke")
		ring.Thickness = def.Thickness
		ring.Transparency = def.BaseTransparency
		ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		ring.Parent = halo
		table.insert(rings, {Instance = ring, BaseTransparency = def.BaseTransparency, IntensityBoost = def.IntensityBoost})
	end

	if KazeUI.PerformanceMode then

		for _, r in ipairs(rings) do r.Instance.Color = KazeUI.GlowColor end
	else
		GlowTargetSet[halo] = true
		TrackDestroy(halo)
		table.insert(KazeUI.GlowElements, {Target = halo, HaloRings = rings})
		GlowWake()
	end
	return halo
end

local function StopNeonLoop(target)
	if not target then return end
	if GlowTargetSet[target] then
		GlowTargetSet[target] = nil
		local list = KazeUI.GlowElements
		for i = #list, 1, -1 do
			if list[i].Target == target then table.remove(list, i) end
		end
		glowDirty = true
	elseif #FrozenGlow > 0 then
		for i = #FrozenGlow, 1, -1 do
			if FrozenGlow[i].Target == target then table.remove(FrozenGlow, i) end
		end
	end
	local ok, grad = pcall(target.FindFirstChild, target, "KazeGlowGradient")
	if ok and grad and grad.Enabled then grad.Enabled = false end
end

local KickStroke
do
	local pending = setmetatable({}, {__mode = "k"})
	local function Check(strokeInst, state)
		if not strokeInst.Parent then
			state.Conn:Disconnect()
			pending[strokeInst] = nil
			return
		end
		local now = os.clock()
		if now - state.Last < 0.05 and now - state.Start < 0.6 then
			task.delay(0.05, Check, strokeInst, state)
			return
		end
		state.Conn:Disconnect()
		pending[strokeInst] = nil
		strokeInst.Enabled = false
		task.delay(0, function()
			if strokeInst.Parent then strokeInst.Enabled = true end
		end)
	end
	KickStroke = function(strokeInst)
		if not strokeInst then return end
		local state = pending[strokeInst]
		if state then
			state.Last = os.clock()
			return
		end
		local ref = strokeInst.Parent
		if not ref then return end
		local now = os.clock()
		state = {Last = now, Start = now}
		state.Conn = ref:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			state.Last = os.clock()
		end)
		pending[strokeInst] = state
		task.delay(0.05, Check, strokeInst, state)
	end
end

function KazeUI:SetGlow(color)
	KazeUI.GlowColor = color
	KazeUI._userSetGlow = true
	RefreshGlowGradientSequence()

	for i = #KazeUI.GlowCallbacks, 1, -1 do
		local data = KazeUI.GlowCallbacks[i]
		if data.Inst and data.Inst.Parent then
			task.spawn(data.Callback, color)
		else
			table.remove(KazeUI.GlowCallbacks, i)
		end
	end
end

function KazeUI:SetGlowMode(mode)
	if mode == "Cycle" then mode = "Sequence" end
	local valid = {Breathing = true, Sequence = true, Pulse = true, Chase = true}
	if not valid[mode] then mode = "Breathing" end
	KazeUI.GlowMode = mode
end

function KazeUI:SetGlowRainbow(enabled)
	KazeUI.GlowRainbow = enabled and true or false
	RefreshGlowGradientSequence()
end

function KazeUI:SetPerformanceMode(enabled)
	enabled = enabled and true or false
	local wasEnabled = KazeUI.PerformanceMode
	KazeUI.PerformanceMode = enabled
	ApplyTweenProfile(enabled)

	if enabled then
		-- Remember which theme was active BEFORE we force Obsidian, so turning
		-- Performance Mode back off can restore it. Only overwrite the saved
		-- key the first time we actually enter Performance Mode (not on a
		-- redundant SetPerformanceMode(true) call while already enabled), and
		-- never save "Obsidian" itself as the thing to restore to.
		if not wasEnabled and KazeUI.CurrentThemeKey ~= "Obsidian" then
			KazeUI._PrePerformanceThemeKey = KazeUI.CurrentThemeKey
		end

		local list = KazeUI.GlowElements
		for i = 1, #list do
			local data = list[i]
			local target = data.Target
			if target and target.Parent then
				if data.HaloRings then
					for _, ring in ipairs(data.HaloRings) do
						ring.Instance.Color = KazeUI.GlowColor
					end
				else
					target[data.Prop] = KazeUI.GlowColor
					local grad = data.Grad or target:FindFirstChild("KazeGlowGradient")
					if grad then grad.Enabled = false end
				end
				GlowTargetSet[target] = nil
				table.insert(FrozenGlow, data)
			end
		end
		table.clear(list)
		SchedRemove("glow")
		if glowPoll then
			task.cancel(glowPoll)
			glowPoll = nil
		end

		for _, wp in ipairs(KazeUI.WallpaperElements) do
			if wp.ImageLabel and wp.ImageLabel.Parent then
				wp.ImageLabel.ImageTransparency = 1
				wp.ImageLabel.Image = ""
			end
			if wp.OverlayFrame and wp.OverlayFrame.Parent then
				wp.OverlayFrame.BackgroundTransparency = 1
			end
		end

		KazeUI:SetTheme("Obsidian")
	elseif wasEnabled then
		-- Restore whatever theme was active before Performance Mode forced
		-- Obsidian. SetTheme re-applies the theme's colors, panel transparency,
		-- and (via ApplyWallpaper below) its wallpaper -- previously this branch
		-- never left Obsidian at all, since KazeUI.CurrentTheme had been
		-- overwritten and never restored.
		local restoreKey = KazeUI._PrePerformanceThemeKey
		KazeUI._PrePerformanceThemeKey = nil
		if restoreKey and restoreKey ~= "Obsidian" then
			KazeUI:SetTheme(restoreKey)
		end

		for _, data in ipairs(FrozenGlow) do
			local target = data.Target
			if target and target.Parent and not Destroyed[target] and not GlowTargetSet[target] then
				GlowTargetSet[target] = true
				table.insert(KazeUI.GlowElements, data)
			end
		end
		table.clear(FrozenGlow)
		ApplyWallpaper(KazeUI.CurrentTheme)
		if #KazeUI.GlowElements > 0 then GlowWake() end
	end
end

local function ShutdownRuntime()
	if viewportConn then viewportConn:Disconnect() viewportConn = nil end
	if cameraChangedConn then cameraChangedConn:Disconnect() cameraChangedConn = nil end
	if glowPoll then
		task.cancel(glowPoll)
		glowPoll = nil
	end
	for _, t in ipairs(schedList) do t.Dead = true end
	table.clear(schedByKey)
	SchedCompact()
	for _, rec in ipairs(pixelLinesActive) do rec.Active = false end
	table.clear(pixelLinesActive)
	if pixelLineConn then pixelLineConn:Disconnect() pixelLineConn = nil end
end
KazeUI._Shutdown = ShutdownRuntime
ScreenGui.Destroying:Connect(ShutdownRuntime)

