	enterFrameTween:Play()

	local isDismissing = false
	local isDestroyed = false
	local autoThread = nil
	local progressTween = nil
	local outTween, shrinkTween = nil, nil
	local outConn, shrinkConn = nil, nil
	local registryEntry = {}

	local function dismiss()
		if isDismissing or isDestroyed then return end
		isDismissing = true

		outTween = TweenService:Create(notifFrame, TWEEN_NOTIF_OUT, {Position = UDim2.new(1.3, 0, 0, 10)})
		outConn = outTween.Completed:Connect(function()
			if outConn then outConn:Disconnect() outConn = nil end
			if isDestroyed then return end
			shrinkTween = TweenService:Create(notifHolder, TWEEN_NOTIF_SHRINK, {Size = UDim2.new(1, 0, 0, 0)})
			shrinkConn = shrinkTween.Completed:Connect(function()
				if shrinkConn then shrinkConn:Disconnect() shrinkConn = nil end
				StopNeonLoop(progressBar)
				notifHolder:Destroy()
			end)
			shrinkTween:Play()
		end)
		outTween:Play()
	end
	registryEntry.Dismiss = dismiss

	closeBtn.MouseEnter:Connect(function()
		TweenService:Create(closeBtn, TWEEN_FAST, {ImageTransparency = 0.2, Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, -11, 0, 11)}):Play()
	end)
	closeBtn.MouseLeave:Connect(function()
		TweenService:Create(closeBtn, TWEEN_FAST, {ImageTransparency = 0, Size = UDim2.fromOffset(16, 16), Position = UDim2.new(1, -12, 0, 12)}):Play()
	end)
	closeBtn.MouseButton1Down:Connect(function()
		TweenService:Create(closeBtn, TWEEN_FAST, {Size = UDim2.fromOffset(14, 14), Position = UDim2.new(1, -13, 0, 13)}):Play()
	end)
	closeBtn.MouseButton1Click:Connect(dismiss)

	progressTween = TweenService:Create(progressBar, GetLinearTweenInfo(duration), {Size = UDim2.new(0, 0, 1, 0)})
	progressTween:Play()
	autoThread = task.delay(duration, function()
		autoThread = nil
		if not isDismissing then dismiss() end
	end)

	notifHolder.Destroying:Connect(function()
		isDestroyed = true
		isDismissing = true
		if autoThread then
			pcall(task.cancel, autoThread)
			autoThread = nil
		end
		if outConn then outConn:Disconnect() outConn = nil end
		if shrinkConn then shrinkConn:Disconnect() shrinkConn = nil end
		enterHolderTween:Cancel()
		enterFrameTween:Cancel()
		if progressTween then progressTween:Cancel() progressTween = nil end
		if outTween then outTween:Cancel() outTween = nil end
		if shrinkTween then shrinkTween:Cancel() shrinkTween = nil end
		StopNeonLoop(progressBar)
		if rgbEntry then
			for i = #RGBTitles, 1, -1 do
				if RGBTitles[i] == rgbEntry then table.remove(RGBTitles, i) break end
			end
			rgbEntry = nil
		end
		for i = #ActiveNotifs, 1, -1 do
			if ActiveNotifs[i] == registryEntry then table.remove(ActiveNotifs, i) break end
		end
	end)

	table.insert(ActiveNotifs, registryEntry)
	while #ActiveNotifs > MAX_ACTIVE_NOTIFS do
		local oldest = table.remove(ActiveNotifs, 1)
		if oldest and oldest.Dismiss then oldest.Dismiss() end
	end
end

function KazeUI:SaveConfig(name)
	if not name or name == "" then
		KazeUI:Notify({Title = "Config System", Content = "Config name cannot be empty.", Duration = 3})
		return
	end

	local data = {}
	for flag, obj in pairs(KazeUI.Flags) do data[flag] = obj.Get() end

	if writefile then
		local success, encoded = pcall(function() return HttpService:JSONEncode(data) end)
		if success then
			local folder = KazeUI.AuthorName
			if makefolder then
				pcall(function()
					if isfolder and not isfolder(folder) then makefolder(folder)
					elseif not isfolder then makefolder(folder) end
				end)
			end

			writefile(folder .. "/" .. name .. ".json", encoded)
			KazeUI:Notify({Title = "Config Saved", Content = "Successfully saved " .. name, Duration = 3})
		else
			KazeUI:Notify({Title = "Config Error", Content = "Failed to encode settings.", Duration = 3})
		end
	else
		KazeUI:Notify({Title = "Config Error", Content = "Executor doesn't support file writes.", Duration = 3})
	end
end

function KazeUI:LoadConfig(name)
	if not name or name == "" then return end
	local folder = KazeUI.AuthorName
	local filename = folder .. "/" .. name .. ".json"

	if isfile and isfile(filename) then
		local success, content = pcall(readfile, filename)
		if success and content then
			local s, decoded = pcall(function() return HttpService:JSONDecode(content) end)
			if s and type(decoded) == "table" then
				for flag, val in pairs(decoded) do
					if KazeUI.Flags[flag] then
						pcall(KazeUI.Flags[flag].Set, val)
					end
				end
