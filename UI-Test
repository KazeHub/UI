local function CompactList(list, field)
	local n = #list
	local w = 0
	for r = 1, n do
		local v = list[r]
		local key = v
		if field then key = v[field] end
		if not Destroyed[key] then
			w = w + 1
			if w ~= r then list[w] = v end
		end
	end
	for i = n, w + 1, -1 do list[i] = nil end
end

local function PruneRegistries()
	prunePending = false
	CompactList(KazeUI.TextElements)
	CompactList(KazeUI.MutedTextElements)
	CompactList(KazeUI.BorderElements)
	CompactList(KazeUI.ThemeCallbacks, "Inst")
	CompactList(KazeUI.GlowCallbacks, "Inst")
	CompactList(KazeUI.PanelElements, "Inst")
	CompactList(KazeUI.WallpaperElements, "ImageLabel")
	CompactList(KazeUI.GlowElements, "Target")
	CompactList(FrozenGlow, "Target")
	glowDirty = true
end

local function TrackDestroy(inst)
	if TrackState[inst] ~= nil then return end
	TrackState[inst] = false
	inst.Destroying:Connect(function()
		TrackState[inst] = true
