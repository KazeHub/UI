local PIXEL_LINE_SETTLE_FRAMES = 4
local pixelLinesActive = {}
local pixelLinesAll = {}
local pixelLineConn = nil

local function ApplyPixelLine(rec)
	local scale = UIScale.Scale
	if not scale or scale <= 0 then scale = 1 end
	local absPos = rec.Anchor.AbsolutePosition
	local key
	if rec.Axis == "Y" then key = absPos.Y else key = absPos.X end
	if key == rec.LastKey and scale == rec.LastScale then
		return false
	end
	rec.LastKey = key
	rec.LastScale = scale

	local line = rec.Line
	if rec.Axis == "Y" then
		local snappedTop = math.floor(key + 0.5)
		local localY = (snappedTop - key) / scale
		line.Size = UDim2.new(1, 0, 0, rec.Thickness / scale)
		line.Position = UDim2.new(0, 0, 0, localY)
	else
		local snappedLeft = math.floor(key + 0.5)
		local localX = (snappedLeft - key) / scale
		line.Size = UDim2.new(0, rec.Thickness / scale, 1, 0)
		line.Position = UDim2.new(0, localX, 0, 0)
	end
	return true
end

local function PixelLineStep()
	for i = #pixelLinesActive, 1, -1 do
		local rec = pixelLinesActive[i]
		local remove = false
		if rec.Dead or not rec.Anchor.Parent then
			remove = true
		elseif ApplyPixelLine(rec) then
			rec.Idle = 0
		else
			rec.Idle = rec.Idle + 1
			if rec.Idle >= PIXEL_LINE_SETTLE_FRAMES then remove = true end
		end
		if remove then
			rec.Active = false
			table.remove(pixelLinesActive, i)
		end
	end
	if #pixelLinesActive == 0 and pixelLineConn then
		pixelLineConn:Disconnect()
		pixelLineConn = nil
	end
end

local function WakePixelLine(rec)
	if rec.Dead then return end
	if rec.Active then
		rec.Idle = 0
		return
	end
	rec.Active = true
	rec.Idle = 0
	table.insert(pixelLinesActive, rec)
	if not pixelLineConn then
		pixelLineConn = RunService.RenderStepped:Connect(PixelLineStep)
	end
	if rec.Anchor.Parent then ApplyPixelLine(rec) end
end

UIScale:GetPropertyChangedSignal("Scale"):Connect(function()
	for i = 1, #pixelLinesAll do
		WakePixelLine(pixelLinesAll[i])
	end
end)

function KazeUI:MakePixelStableLine(anchorFrame, axis, thicknessPx)
	if not anchorFrame then return end
	axis = (axis == "X") and "X" or "Y"
	thicknessPx = thicknessPx or 1

	anchorFrame.BackgroundTransparency = 1
	anchorFrame.BorderSizePixel = 0

	local line = Instance.new("Frame")
	line.Name = "PixelStableLine"
	line.BorderSizePixel = 0
	line.ZIndex = anchorFrame.ZIndex
	line.Parent = anchorFrame

	local rec = {
		Anchor = anchorFrame, Line = line, Axis = axis, Thickness = thicknessPx,
		LastKey = nil, LastScale = nil, Idle = 0, Active = false, Dead = false,
	}
	table.insert(pixelLinesAll, rec)

	ApplyPixelLine(rec)
	local posConn = anchorFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
		WakePixelLine(rec)
	end)
	local sizeConn = anchorFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		WakePixelLine(rec)
	end)

	anchorFrame.Destroying:Connect(function()
		rec.Dead = true
		posConn:Disconnect()
		sizeConn:Disconnect()
		for i = #pixelLinesAll, 1, -1 do
			if pixelLinesAll[i] == rec then table.remove(pixelLinesAll, i) break end
		end
	end)

	return line
end

