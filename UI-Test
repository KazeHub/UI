		KazeUI:RegisterText(ptitleLabel, false)
	end

	local valueLabel = Instance.new("TextLabel", inner)
	valueLabel.Size = UDim2.new(0, 70, 0, titleHeight > 0 and titleHeight or 18)
	valueLabel.Position = UDim2.new(1, -70, 0, 0)
