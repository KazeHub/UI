	TweenService:Create(labelText, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
	TweenService:Create(percentText, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
	TweenService:Create(barTrack, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
	TweenService:Create(barFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
	TweenService:Create(cardScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()

	local lastPct, lastLabel = nil, nil
	local lastProgressClock = 0
	local barTween = nil
	local loadingDone = false
	KazeUI._IntroDone = false
	KazeUI._IntroQueue = nil

	local function SetLoadingProgress(pct, label)
		if loadingDone then return end
		pct = math.clamp(pct, 0, 100)
		label = tostring(label or "Loading")
		if pct == lastPct and label == lastLabel then return end

		local now = os.clock()
		if pct < 100 and label == lastLabel and lastPct and (now - lastProgressClock) < 0.05 then return end
		lastProgressClock = now

		if pct ~= lastPct then
			lastPct = pct
			if barTween then barTween:Cancel() end
			barTween = TweenService:Create(barFill, TWEEN_LOAD_BAR, {
				Size = UDim2.new(pct / 100, 0, 1, 0)
			})
			barTween:Play()
			percentText.Text = string.format("%d%%", math.floor(pct))
		end
		if label ~= lastLabel then
			lastLabel = label
			labelText.Text = label
		end
	end

	local FADE_OUT = TWEEN_LOAD_FADE
	local function FinishLoadingScreen()
		if loadingDone then return end
		SetLoadingProgress(100, "Ready")
		loadingDone = true
		task.wait(0.05)
		local fade = TweenService:Create(LoadingScreen, FADE_OUT, {BackgroundTransparency = 1})
		TweenService:Create(cardScale, FADE_OUT, {Scale = 0.92}):Play()
		TweenService:Create(loadCard, FADE_OUT, {BackgroundTransparency = 1}):Play()
		TweenService:Create(cardStroke, FADE_OUT, {Transparency = 1}):Play()
		TweenService:Create(spinnerStroke, FADE_OUT, {Transparency = 1}):Play()
		TweenService:Create(loadLogo, FADE_OUT, {ImageTransparency = 1}):Play()
		TweenService:Create(loadTitle, FADE_OUT, {TextTransparency = 1}):Play()
		TweenService:Create(loadSubtitle, FADE_OUT, {TextTransparency = 1}):Play()
		TweenService:Create(labelText, FADE_OUT, {TextTransparency = 1}):Play()
		TweenService:Create(percentText, FADE_OUT, {TextTransparency = 1}):Play()
		TweenService:Create(barTrack, FADE_OUT, {BackgroundTransparency = 1}):Play()
		TweenService:Create(barFill, FADE_OUT, {BackgroundTransparency = 1}):Play()
		fade:Play()

		task.wait(FADE_OUT.Time)

		StopNeonLoop(cardStroke)
		StopNeonLoop(spinnerStroke)
		StopNeonLoop(barFill)
		if loadHalo then StopNeonLoop(loadHalo) end
		spinnerTween:Cancel()
		logoPulseTween:Cancel()
		if shimmerTween then shimmerTween:Cancel() end
		if barTween then barTween:Cancel() barTween = nil end
		LoadingScreen:Destroy()
		KazeUI._IntroDone = true
		local queue = KazeUI._IntroQueue
		if queue then
			KazeUI._IntroQueue = nil
			for _, fn in ipairs(queue) do
				task.spawn(function() pcall(fn) end)
			end
		end
	end

	local preloadStarted = false
	local preloadThread, timeoutThread = nil, nil
	local function RunAssetPreload()
		if preloadStarted then return end
		preloadStarted = true

		local assetList = {}
		for assetId in pairs(KazeUI._PreloadSet) do
			table.insert(assetList, assetId)
		end

		table.clear(KazeUI._PreloadSet)

		local total = #assetList
		if total == 0 then
			FinishLoadingScreen()
			return
		end

		SetLoadingProgress(50, "Loading assets")
		local loaded = 0
		local finished = false
		local function safeFinish()
			if finished then return end
			finished = true

			local me = coroutine.running()
			if timeoutThread and timeoutThread ~= me then pcall(task.cancel, timeoutThread) end
			if preloadThread and preloadThread ~= me then pcall(task.cancel, preloadThread) end
			timeoutThread, preloadThread = nil, nil
			FinishLoadingScreen()
		end

		preloadThread = task.spawn(function()
			pcall(function()
				ContentProvider:PreloadAsync(assetList, function()
					loaded = loaded + 1
					local pct = 50 + math.floor((loaded / total) * 50)
					SetLoadingProgress(pct, "Loading assets")
				end)
			end)
			safeFinish()
		end)

		timeoutThread = task.delay(2, safeFinish)
	end

	KazeUI._RunAssetPreload = RunAssetPreload
	task.spawn(function()
		task.wait(0.05)
		RunAssetPreload()
	end)

	SetLoadingProgress(8, "Initializing")

