local function RegisterFlag(flag, getFunc, setFunc)
	if flag then
		KazeUI.Flags[flag] = { Get = getFunc, Set = setFunc }
	end
end

local function ChainCallback(prev, fn)
	if typeof(fn) ~= "function" then return prev end
	if typeof(prev) ~= "function" then return fn end
	return function(...)
		pcall(prev, ...)
		pcall(fn, ...)
	end
end

