	toggleDetector.Size = UDim2.fromScale(1, 1)
	toggleDetector.BackgroundTransparency = 1
	toggleDetector.Text = ""
	toggleDetector.ZIndex = 10
	toggleDetector.Parent = header

	local openTween
	local function setClipperOpen(open)
		if openTween then openTween:Cancel() end
		if open then
			containerClipper.AutomaticSize = Enum.AutomaticSize.None
			local targetHeight = container.AbsoluteSize.Y
			openTween = TweenService:Create(containerClipper, TWEEN_COLLAPSE, {Size = UDim2.new(1, 0, 0, targetHeight)})
			local thisTween = openTween
			thisTween.Completed:Connect(function()
				if isOpen and containerClipper.Parent then
					containerClipper.AutomaticSize = Enum.AutomaticSize.Y
				end
			end)
			thisTween:Play()
		else
			containerClipper.Size = UDim2.new(1, 0, 0, containerClipper.AbsoluteSize.Y)
			containerClipper.AutomaticSize = Enum.AutomaticSize.None
			openTween = TweenService:Create(containerClipper, TWEEN_COLLAPSE, {Size = UDim2.new(1, 0, 0, 0)})
			openTween:Play()
		end
	end

	local function toggleGroup()
		isOpen = not isOpen
		setClipperOpen(isOpen)

		if isOpen then
			TweenService:Create(arrowIcon, TWEEN_COLLAPSE, {
				Rotation = 0,
				ImageColor3 = KazeUI.CurrentTheme.Text
			}):Play()
			StartNeonLoop(stroke)
			StartNeonLoop(accentLine)
		else
			TweenService:Create(arrowIcon, TWEEN_COLLAPSE, {
				Rotation = -90,
				ImageColor3 = KazeUI.CurrentTheme.MutedText
			}):Play()
			TweenService:Create(accentLine, TWEEN_COLLAPSE, {
				BackgroundColor3 = KazeUI.CurrentTheme.MutedText
			}):Play()
			StopNeonLoop(stroke)
			StopNeonLoop(accentLine)
			stroke.Color = KazeUI.CurrentTheme.Border
			accentLine.BackgroundColor3 = KazeUI.CurrentTheme.MutedText
		end
	end

	toggleDetector.MouseEnter:Connect(function()
		if activeDialogsCount > 0 then return end
		TweenService:Create(header, TWEEN_HOVER_SLOW, {BackgroundColor3 = KazeUI.GetColor(0.04), BackgroundTransparency = 0.4}):Play()
	end)
	toggleDetector.MouseLeave:Connect(function()
		TweenService:Create(header, TWEEN_HOVER_SLOW, {BackgroundTransparency = 1}):Play()
	end)

	toggleDetector.MouseButton1Down:Connect(function()
		if activeDialogsCount > 0 then return end
		local curY = groupFrame.Size.Y
		TweenService:Create(groupFrame, TWEEN_QUICK, {Size = UDim2.new(scaledWidth - 0.02, 0, curY.Scale, curY.Offset)}):Play()
	end)
	toggleDetector.MouseButton1Up:Connect(function()
		if activeDialogsCount > 0 then return end
		task.defer(function()
			local curY = groupFrame.Size.Y
			TweenService:Create(groupFrame, TWEEN_QUICK, {Size = UDim2.new(scaledWidth, 0, curY.Scale, curY.Offset)}):Play()
		end)
		toggleGroup()
	end)

	if openDefault then toggleGroup() end

	local groupPublic = {
		Frame = groupFrame,
		Container = container,
		Header = header
	}

	AttachElementsToAPI(groupPublic, container, currentDepth + 1)

	function groupPublic:SetText(newText)
		if header then
			local lbl = header:FindFirstChildOfClass("TextLabel")
			if lbl then lbl.Text = tostring(newText) end
		end
	end

	groupPublic.SetVisible = ElementSetVisible
	groupPublic.Destroy = ElementDestroy
	return groupPublic
end

