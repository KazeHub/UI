local function MakeDraggable(dragPart, targetPart, dragState)
	dragState = dragState or { Position = targetPart.Position, Anchor = targetPart.AnchorPoint }
	local dragging = false
	local dragInput, dragStart, startPos
	local dragActive = false
	local moveConn = nil

	dragPart.Active = true

	local function stopDrag()
		if moveConn then moveConn:Disconnect() moveConn = nil end
		if dragging then UnlockCamera() end
		dragging = false
		dragInput = nil
	end

	local function update(input)
		if not dragStart or not startPos then return end
		local delta = input.Position - dragStart
		local scale = UIScale.Scale

		if dragActive or delta.Magnitude > 8 then
			dragActive = true
			local newPos = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + (delta.X / scale),
				startPos.Y.Scale, startPos.Y.Offset + (delta.Y / scale)
			)
			if targetPart.Position ~= newPos then
				targetPart.Position = newPos
			end

			if targetPart.Name == "Frame" or targetPart:IsA("Frame") then
				dragState.Position = targetPart.Position
				dragState.Anchor = targetPart.AnchorPoint
			end
		end
	end

	dragPart.InputBegan:Connect(function(input)
		if KazeUI.IsResizing or activeDialogsCount > 0 then return end

		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then stopDrag() end
			dragging = true
			dragActive = false
			dragStart = input.Position
			startPos = targetPart.Position

			LockCamera()

			moveConn = UIS.InputChanged:Connect(function(changed)
				if changed == dragInput and dragging then update(changed) end
			end)

			local changeCon
			changeCon = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					stopDrag()
					if changeCon then changeCon:Disconnect() end
				end
			end)
		end
	end)

	dragPart.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	if dragPart and typeof(dragPart) == "Instance" then
		dragPart.Destroying:Connect(stopDrag)
	end
end

