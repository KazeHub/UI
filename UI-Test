local function ElementSetVisible(self, visible)
	local f = self.Wrapper or self.Frame
	f.Visible = visible ~= false
end

local function ElementDestroy(self)
	local flag, entry = self.FlagName, self.FlagEntry
	if flag and entry and KazeUI.Flags[flag] == entry then KazeUI.Flags[flag] = nil end
	local f = self.Wrapper or self.Frame
	f:Destroy()
end

local function FinishElement(api, flag)
	api.SetVisible = ElementSetVisible
	api.Destroy = ElementDestroy
	if flag then
		api.FlagName = flag
		api.FlagEntry = KazeUI.Flags[flag]
	end
	return api
end

