	local function ApplyGrid()
		local scale = header.AbsoluteSize.Y / 34
		if scale <= 0 then scale = 1 end
		local width = scrollFrame.AbsoluteSize.X / scale - 6
		if width < GRID_MIN_CELL then width = 280 end
		local cols = math.clamp(math.floor((width + GRID_GAP) / (GRID_MIN_CELL + GRID_GAP)), 2, 6)
		if cols ~= appliedCols or cellHeight ~= appliedHeight then
			appliedCols, appliedHeight = cols, cellHeight
			gridLayout.FillDirectionMaxCells = cols
			gridLayout.CellSize = UDim2.new(1 / cols, -(math.ceil(GRID_GAP * (cols - 1) / cols) + 1), 0, cellHeight)
		end
		local rows = math.max(1, math.ceil(visibleCount / cols))
		local target = UDim2.new(1, -20, 0, math.min(rows * cellHeight + (rows - 1) * GRID_GAP, MAX_VISIBLE_HEIGHT))
		if scrollFrame.Size ~= target then scrollFrame.Size = target end
