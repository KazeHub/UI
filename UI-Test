	local function unminimizeWindow()
		if not isMinimized then return end
		isMinimized = false

		if openButtonHidable then
			MiniButton.Visible = false
		end
		Window.Visible = true

		local pinned = {}
		local scrollWas = {}
		for sf in pairs(ScrollerRegistry) do
			if sf.Parent and sf:IsDescendantOf(Window) then
				scrollWas[sf] = sf.ScrollingEnabled
				sf.ScrollingEnabled = false
				local cp = sf.CanvasPosition
				if cp.X ~= 0 or cp.Y ~= 0 then pinned[sf] = cp end
			end
		end

		local pinConn, pinDestroyConn
		local function finishRestore()
			if pinConn then pinConn:Disconnect() pinConn = nil end
			if pinDestroyConn then pinDestroyConn:Disconnect() pinDestroyConn = nil end
			for sf, was in pairs(scrollWas) do
				if sf.Parent then sf.ScrollingEnabled = was end
			end
			table.clear(scrollWas)
			table.clear(pinned)
		end

		if next(pinned) ~= nil then
			pinConn = RunService.Heartbeat:Connect(function()
				for sf, pos in pairs(pinned) do
					if sf.Parent then
						if sf.CanvasPosition ~= pos then sf.CanvasPosition = pos end
					else
						pinned[sf] = nil
					end
				end
				if next(pinned) == nil and pinConn then
					pinConn:Disconnect()
					pinConn = nil
				end
			end)
		end
		pinDestroyConn = Window.Destroying:Connect(finishRestore)

		if toggledMaximized then
			Window.AnchorPoint = Vector2.new(0.5, 0.5)
			local finalPos, finalSize = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.95, 0.9)
			local startPos, startSize = computeCenterGrowStart(Window.AnchorPoint, finalPos, finalSize)
			Window.Position = startPos
			Window.Size = startSize
			local tween = TweenService:Create(Window, TWEEN_SPRING, {Position = finalPos, Size = finalSize})
			tween.Completed:Connect(finishRestore)
			tween:Play()
		else
			Window.AnchorPoint = dragState.Anchor
			local finalPos, finalSize = dragState.Position, lastNormalSize
			local startPos, startSize = computeCenterGrowStart(Window.AnchorPoint, finalPos, finalSize)
			Window.Position = startPos
			Window.Size = startSize
			local tween = TweenService:Create(Window, TWEEN_SPRING, {Position = finalPos, Size = finalSize})
			tween.Completed:Connect(finishRestore)
			tween:Play()
		end
	end

